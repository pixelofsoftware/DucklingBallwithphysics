# Observation clock; never decides whether a simulation Step should run.
fun monotonicClock() -> ClockValue = { return platform.monotonicClock(); }
# A controlled test may replace only this observer, never the stepping path.
var clockRead: funptr() -> ClockValue = monotonicClock;
fun addTime(r: ref Recording,before: ClockValue,after: ClockValue,render: bool) -> () = {
    if (not before.valid or not after.valid or after.nanoseconds<before.nanoseconds) { r.time.status = IO; return; }
    let delta: u64 = after.nanoseconds-before.nanoseconds;
    let previous: u64 = if render then r.time.renderNs else r.time.physicsNs;
    if (delta>18446744073709551615u64-previous) { r.time.status = IO; return; }
    if (render) r.time.renderNs = previous+delta; else r.time.physicsNs = previous+delta;
}
fun bodySerial(r: ref Recording,n: game.BodyNumber) -> i64 = { var i: i64 = 0i64; while (i<r.map.length()) { var m: ref Mapping = r.map.at(i); if (m.kind==1i32 and m.body.slot==n.slot and game.equalKey(m.body.birthTicket,n.birthTicket) and game.equalKey(m.body.ownerTicket,n.ownerTicket)) return i+1i64; i += 1i64; } return 0i64; }
fun shapeSerial(r: ref Recording,n: game.ShapeNumber) -> i64 = { var i: i64 = 0i64; while (i<r.map.length()) { var m: ref Mapping = r.map.at(i); if (m.kind==2i32 and m.shape.slot==n.slot and game.equalKey(m.shape.birthTicket,n.birthTicket) and game.equalKey(m.shape.ownerTicket,n.ownerTicket)) return i+1i64; i += 1i64; } return 0i64; }
fun jointSerial(r: ref Recording,n: game.JointNumber) -> i64 = { var i: i64 = 0i64; while (i<r.map.length()) { var m: ref Mapping = r.map.at(i); if (m.kind==4i32 and m.joint.slot==n.slot and game.equalKey(m.joint.birthTicket,n.birthTicket) and game.equalKey(m.joint.ownerTicket,n.ownerTicket)) return i+1i64; i += 1i64; } return 0i64; }
fun chainSerial(r: ref Recording,n: game.ChainNumber) -> i64 = { var i: i64 = 0i64; while (i<r.map.length()) { var m: ref Mapping = r.map.at(i); if (m.kind==3i32 and m.chain.slot==n.slot and game.equalKey(m.chain.birthTicket,n.birthTicket) and game.equalKey(m.chain.ownerTicket,n.ownerTicket)) return i+1i64; i += 1i64; } return 0i64; }
fun stepValue(r: ref Recording,v: ref game.StepResult) -> RecordedStep = {
    var result = RecordedStep(v.status,v.reason); result.effectiveSubSteps = v.effectiveSubSteps; result.didSolve = v.didSolve; result.sensorReason = v.sensorReason;
    result.shapeA = TapeShape(shapeSerial(r,v.shapeA),r.session); result.shapeB = TapeShape(shapeSerial(r,v.shapeB),r.session);
    var i: i64 = 0i64; while (i<v.values.length()) { let m: game.BodyMove = v.values.at(i); result.values.push(TapeMove(TapeBody(bodySerial(r,m.number),r.session),m.transform,m.hasObjectId,m.objectId,m.fellAsleep)); i += 1i64; } return result;
}
fun doStep(r: ref Recording,manual: bool,record: bool) -> RecordedStep = {
    if (r.phase==0i32) return RecordedStep(game.STALE);
    if (r.rendering or record and r.phase!=2i32) return RecordedStep(MODE);
    if (record and (r.tape.records.length()+3i64>r.tape.limits.maxRecords or r.serializedBytes+70i64>r.tape.limits.maxBytes)) return RecordedStep(TAPE_LIMIT);
    let tickBefore: i64 = r.gameSession.stepIndex;
    let started = clockRead();
    var stepped = game.StepResult(); if (manual) stepped = start.manualStep(&r.gameSession); else stepped = start.tick(&r.gameSession);
    let ended = clockRead();
    # Early step refusals are not physical attempts and never create T.
    let attempted: bool = stepped.reason!=1001i32 and stepped.reason!=1002i32 and stepped.status!=game.STALE and stepped.status!=game.LOCKED and tickBefore!=9223372036854775807i64;
    if (attempted) { addTime(r,started,ended,false); if (stepped.status==game.OK) { if (r.time.steps==18446744073709551615u64) r.time.status = IO; else r.time.steps += 1u64; }
        if (record) { var e = Entry(); e.kind = 2i32; e.tick = tickBefore; e.status = stepped.status; e.reason = stepped.reason;
            var row = recordLine(&e,r.tape.records.length()); r.serializedBytes += row.length(); r.tape.records.push(move e); } }
    rememberContacts(r); var result = stepValue(r,&stepped); if (attempted) r.lastStep = copy result; return result;
}
fun tick(recording: ref Recording) -> RecordedStep = { return doStep(recording,false,true); }
fun manualStep(recording: ref Recording) -> RecordedStep = { return doStep(recording,true,true); }
fun queueTime(recording: ref Recording,elapsedNanoseconds: i64) -> start.FrameBudget = { if (recording.phase==0i32) return start.FrameBudget(game.STALE); return start.queueTime(&recording.gameSession,elapsedNanoseconds); }
fun setPaused(recording: ref Recording,paused: bool) -> i32 = { if (recording.phase==0i32) return game.STALE; return start.setPaused(&recording.gameSession,paused); }
fun beginRender(recording: ref Recording) -> TapeAction = { if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.rendering or recording.phase==1i32 or recording.phase==3i32) return TapeAction(MODE);
    let stamp = clockRead(); if (not stamp.valid) { recording.time.status = IO; return TapeAction(IO); } recording.rendering = true; recording.renderStart = stamp.nanoseconds; return TapeAction(); }
fun endRender(recording: ref Recording) -> TapeAction = { if (recording.phase==0i32) return TapeAction(game.STALE); if (not recording.rendering) return TapeAction(MODE);
    let stamp = clockRead(); recording.rendering = false; addTime(recording,ClockValue(true,recording.renderStart),stamp,true); return TapeAction(recording.time.status); }
fun timings(recording: ref Recording) -> TimingValues = { if (recording.phase==0i32) return TimingValues(game.STALE); return recording.time; }
fun resetTimings(recording: ref Recording) -> TapeAction = { if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.rendering) return TapeAction(MODE); recording.time = TimingValues(); return TapeAction(); }
fun begin(settings: start.GameSettings,applicationVersion: str,limits: TapeLimits = TapeLimits()) -> RecordingResult = {
    if (not validLimits(limits) or not validApplication(applicationVersion)) return RecordingResult(game.PARAM);
    if (issuedSession==9223372036854775807i64) return RecordingResult(TAPE_LIMIT);
    var result = RecordingResult(); result.value.tape.settings = settings; result.value.tape.limits = limits; result.value.tape.application = text(applicationVersion);
    var e = Entry(); e.operation = 0i32; var p = settings.physics;
    pack_Vec2(&e.args,&p.gravity,0i64); putWord(&e.args,floatBits(p.maximumLinearSpeed)); putWord(&e.args,floatBits(p.contactHertz)); putWord(&e.args,floatBits(p.contactDampingRatio)); putWord(&e.args,floatBits(p.maxContactPushSpeed)); putWord(&e.args,floatBits(p.restitutionThreshold)); putWord(&e.args,floatBits(p.hitEventThreshold)); putNumber(&e.args,if p.enableWarmStarting then 1i64 else 0i64); putNumber(&e.args,if settings.enableSleeping then 1i64 else 0i64); putNumber(&e.args,if settings.enableContinuous then 1i64 else 0i64);
    var row = recordLine(&e,0i64); if (limits.maxRecords<3i64 or serializedSize(&result.value.tape)+row.length()>limits.maxBytes) return RecordingResult(TAPE_LIMIT);
    var executed = execute(&result.value,&e,true); if (executed.status!=game.OK) return RecordingResult(executed.status,executed.reason);
    issuedSession += 1i64; result.value.session = issuedSession; result.value.phase = 1i32;
    result.value.serializedBytes = serializedSize(&result.value.tape)+row.length(); result.value.tape.records.push(move e); return result;
}
fun sealInitial(recording: ref Recording) -> TapeAction = { if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.phase!=1i32) return TapeAction(MODE); recording.tape.initialCount = recording.tape.records.length(); recording.phase = 2i32; return TapeAction(); }
fun finish(recording: ref Recording) -> TapeResult = { if (recording.phase==0i32) return TapeResult(game.STALE); if (recording.phase!=2i32 or recording.rendering) return TapeResult(MODE); recording.phase = 3i32; recording.tape.valid = true; var result = TapeResult(); result.value = copy recording.tape; return result; }
fun close(recording: ref Recording) -> TapeAction = { if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.rendering) return TapeAction(MODE); let status: i32 = start.closeGame(&recording.gameSession); if (status==game.OK) recording.phase = 0i32; return TapeAction(status); }
fun sameResults(a: ref Entry,b: ref Entry) -> bool = { if (a.status!=b.status or a.reason!=b.reason or a.created.length()!=b.created.length()) return false; var i: i64 = 0i64; while (i<a.created.length()) { if (a.created.at(i)!=b.created.at(i)) return false; i += 1i64; } return true; }
fun replayEntry(r: ref Recording,saved: ref Entry) -> TapeAction = {
    if (saved.tick!=r.gameSession.stepIndex) return TapeAction(DIVERGED);
    if (saved.kind==2i32) { var steppedResult = doStep(r,true,false); if (steppedResult.status!=saved.status or steppedResult.reason!=saved.reason) return TapeAction(DIVERGED); return TapeAction(); }
    var actualEntry: Entry = copy saved; actualEntry.created.clear(); var result = execute(r,&actualEntry,true); actualEntry.status = result.status; actualEntry.reason = result.reason;
    rememberContacts(r); if (not sameResults(saved,&actualEntry)) return TapeAction(DIVERGED); return TapeAction();
}
fun reconstruct(t: ref Tape,session: i64) -> RecordingResult = {
    if (not t.valid or t.initialCount<1i64 or t.initialCount>t.records.length()) return RecordingResult(FORMAT);
    var result = RecordingResult(); result.value.session = session; result.value.tape = copy t; result.value.phase = 4i32;
    var i: i64 = 0i64; while (i<t.initialCount) { let check = replayEntry(&result.value,t.records.at(i)); if (check.status!=game.OK) { if (game.worldStatus(result.value.gameSession.world)==game.OK) start.closeGame(&result.value.gameSession); return RecordingResult(check.status,check.reason); } i += 1i64; }
    start.setPaused(&result.value.gameSession,true); result.value.cursor = t.initialCount; return result;
}
fun restartTape(recording: ref Recording) -> TapeAction = {
    if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.rendering or recording.phase<3i32) return TapeAction(MODE);
    var built = reconstruct(&recording.tape,recording.session); if (built.status!=game.OK) return TapeAction(built.status,built.reason);
    let closed: i32 = start.closeGame(&recording.gameSession); if (closed!=game.OK) { start.closeGame(&built.value.gameSession); return TapeAction(closed); }
    recording = copy built.value; return TapeAction();
}
fun open(tape: ref Tape) -> RecordingResult = { if (issuedSession==9223372036854775807i64) return RecordingResult(TAPE_LIMIT); var result = reconstruct(tape,issuedSession+1i64); if (result.status==game.OK) issuedSession += 1i64; return result; }
fun replaySteps(recording: ref Recording,count: i64) -> TapeAction = {
    if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.phase<4i32 or recording.rendering) return TapeAction(MODE);
    if (not recording.gameSession.paused) return TapeAction(game.PARAM,1002i32);
    if (count<0i64) return TapeAction(game.PARAM); var available: i64 = 0i64; var i: i64 = recording.cursor;
    while (i<recording.tape.records.length()) { if (recording.tape.records.at(i).kind==2i32) available += 1i64; i += 1i64; }
    if (count>available) return TapeAction(game.PARAM); var done: i64 = 0i64;
    while (done<count) { var saved: ref Entry = recording.tape.records.at(recording.cursor); let isStep: bool = saved.kind==2i32;
        # Copy before execution: execution can grow maps but never changes the saved record.
        var entry: Entry = copy saved; let check = replayEntry(recording,&entry); if (check.status!=game.OK) return check;
        recording.cursor += 1i64; if (isStep) {
            done += 1i64;
            # The character finishes the recorded tick with its explicit, ordered move calls.
            while (recording.cursor<recording.tape.records.length()
                and recording.tape.records.at(recording.cursor).kind==1i32 and recording.tape.records.at(recording.cursor).operation==147i32) {
                var next: ref Entry = recording.tape.records.at(recording.cursor);
                var afterStep: Entry = copy next; let moved = replayEntry(recording,&afterStep); if (moved.status!=game.OK) return moved;
                recording.cursor += 1i64;
            }
        } }
    if (recording.cursor==recording.tape.records.length()) recording.phase = 5i32; return TapeAction();
}
fun replayAll(recording: ref Recording) -> TapeAction = {
    if (recording.phase==0i32) return TapeAction(game.STALE); if (recording.phase<4i32 or recording.rendering) return TapeAction(MODE);
    if (not recording.gameSession.paused) return TapeAction(game.PARAM,1002i32);
    while (recording.cursor<recording.tape.records.length()) { let check = replayEntry(recording,recording.tape.records.at(recording.cursor)); if (check.status!=game.OK) return check; recording.cursor += 1i64; }
    recording.phase = 5i32; return TapeAction();
}
fun lookupBody(recording: ref Recording,number: TapeBody) -> game.BodyLookup = { if (recording.phase==0i32) return game.BodyLookup(game.STALE); let status: i32 = mappingStatus(recording,Historical(number.serial,number.session!=recording.session),1i32); if (status!=game.OK) return game.BodyLookup(status); return game.lookupBody(recording.gameSession.world,recording.map.at(number.serial-1i64).body); }
fun getShapes(recording: ref Recording,number: TapeBody) -> TapeShapeList = { var result = TapeShapeList(); if (recording.phase==0i32) return TapeShapeList(game.STALE); result.status = mappingStatus(recording,Historical(number.serial,number.session!=recording.session),1i32); if (result.status!=game.OK) return result;
    var shapes = game.getShapes(recording.gameSession.world,recording.map.at(number.serial-1i64).body); result.status = shapes.status; var i: i64 = 0i64; while (i<shapes.values.length()) { result.values.push(TapeShape(shapeSerial(recording,shapes.values.at(i)),recording.session)); i += 1i64; } return result; }
fun chainSegments(recording: ref Recording,number: TapeChain) -> TapeShapeList = { var result = TapeShapeList(); if (recording.phase==0i32) return TapeShapeList(game.STALE); result.status = mappingStatus(recording,Historical(number.serial,number.session!=recording.session),3i32); if (result.status!=game.OK) return result;
    var shapes = game.chainSegments(recording.gameSession.world,recording.map.at(number.serial-1i64).chain); result.status = shapes.status; var i: i64 = 0i64; while (i<shapes.values.length()) { result.values.push(TapeShape(shapeSerial(recording,shapes.values.at(i)),recording.session)); i += 1i64; } return result; }


fun crcByte(crc: u32,value: u8) -> u32 = { var c: u32 = crc^(value as u32); var i: i32 = 0i32; while (i<8i32) { c = (c>>1u32)^(if (c&1u32)!=0u32 then 3988292384u32 else 0u32); i += 1i32; } return c; }
fun appendBytes(result: ref List[u8],s: ref String) -> () = { var i: i64 = 0i64; while (i<s.length()) { let c: char = s.at(i); result.push(c as u8); i += 1i64; } }
fun encode(tape: ref Tape) -> TapeBytes = {
    if (not tape.valid) return TapeBytes(MODE); var result = TapeBytes(); var h = header(tape); var s = settingsLine(tape); appendBytes(&result.values,&h); appendBytes(&result.values,&s);
    var i: i64 = 0i64; while (i<tape.records.length()) { var row = recordLine(tape.records.at(i),i); appendBytes(&result.values,&row); i += 1i64; }
    var crc: u32 = 4294967295u32; var bi: i64 = 0i64; while (bi<result.values.length()) { let b: u8 = result.values.at(bi); crc = crcByte(crc,b); bi += 1i64; }
    var z = text("Z "); z.append(decimal(tape.records.length()+2i64)); z.append(' '); z.append(word(crc^4294967295u32)); z.append('\n'); appendBytes(&result.values,&z);
    if (result.values.length()>tape.limits.maxBytes or tape.records.length()+2i64>tape.limits.maxRecords) return TapeBytes(TAPE_LIMIT);
    return result;
}
class FileReader { bytes: List[u8] = byteList(); position: i64 = 0i64; line: i64 = 0i64; valid: bool = true; crc: u32 = 4294967295u32; }
fun rowTokens(f: ref FileReader,checksum: bool) -> Reader = {
    var result = Reader(); f.line += 1i64; if (f.position==f.bytes.length()) { f.valid = false; result.valid = false; return result; }
    var token = stringReserve(32i64); var ended: bool = false; var previousSpace: bool = true;
    while (f.position<f.bytes.length() and not ended) {
        let b: u8 = f.bytes.at(f.position); f.position += 1i64;
        if (b==13u8) { if (f.position>=f.bytes.length()) { f.valid = false; return result; } let nextByte: u8 = f.bytes.at(f.position); if (nextByte!=10u8) { f.valid = false; return result; } }
        else if (b==10u8) { if (previousSpace) { f.valid = false; return result; } result.values.push(copy token); ended = true; if (checksum) f.crc = crcByte(f.crc,10u8); }
        else {
            if (b<32u8 or b>=127u8) { f.valid = false; return result; }
            if (checksum) f.crc = crcByte(f.crc,b);
            if (b==32u8) { if (previousSpace) { f.valid = false; return result; } result.values.push(copy token); token = stringReserve(32i64); previousSpace = true; }
            else { token.append(b as char); previousSpace = false; }
        }
    }
    if (not ended) f.valid = false; return result;
}
fun failed(error: str,line: i64) -> TapeLoad = { var result = TapeLoad(); result.error = error; result.line = line;
    if (eq(error,"VERSION")) result.status = VERSION; else if (eq(error,"IO")) result.status = IO; else if (eq(error,"LIMIT")) result.status = TAPE_LIMIT;
    else { result.status = FORMAT; result.reason = line as i32; } return result; }
fun decode(bytes: ref List[u8],applicationVersion: str,limits: TapeLimits = TapeLimits()) -> TapeLoad = {
    if (not validLimits(limits) or not validApplication(applicationVersion)) return TapeLoad(game.PARAM);
    if (bytes.length()>limits.maxBytes) return failed("LIMIT",0i64);
    var f = FileReader(); f.bytes = copy bytes;
    var first = rowTokens(&f,true); if (not f.valid or first.values.length()!=6i64) return failed("FORMAT",1i64);
    var magic = take(&first); if (not eq(magic.asSlice(),"H")) return failed("FORMAT",1i64);
    var family = take(&first); var version = take(&first); var engine = take(&first); var compiler = take(&first); var application = take(&first);
    if (not eq(family.asSlice(),"R5") or not eq(version.asSlice(),"1") or not eq(engine.asSlice(),ENGINE64) or not eq(compiler.asSlice(),COMPILER40) or not eq(application.asSlice(),applicationVersion)) return failed("VERSION",1i64);
    var result = TapeLoad(); result.value.application = move application; result.value.limits = limits;
    var second = rowTokens(&f,true); if (not f.valid or second.values.length()!=8i64) return failed("FORMAT",2i64);
    var sTag = take(&second); if (not eq(sTag.asSlice(),"S")) return failed("FORMAT",2i64);
    result.value.settings.stepsPerSecond = parseInteger(&second,1i64,240i64) as i32; let dt: u32 = readWord(&second);
    result.value.settings.subStepCount = parseInteger(&second,1i64,64i64) as i32; result.value.settings.maxStepsPerFrame = parseInteger(&second,1i64,64i64) as i32;
    result.value.settings.pixelsPerMetre = fromBits(readWord(&second)); result.value.settings.screenOrigin.x = fromBits(readWord(&second)); result.value.settings.screenOrigin.y = fromBits(readWord(&second));
    if (not second.valid or dt!=floatBits(1.0f32/(result.value.settings.stepsPerSecond as f32)) or not game.finite(result.value.settings.pixelsPerMetre) or result.value.settings.pixelsPerMetre<=0.0f32 or not game.finiteVector(result.value.settings.screenOrigin)) return failed("FORMAT",2i64);
    var tickIndex: i64 = 0i64; var nextSerial: i64 = 1i64; var inInitial: bool = true; var complete: bool = false;
    while (not complete) {
        if (f.position>=f.bytes.length()) return failed("FORMAT",f.line+1i64);
        let firstByte: u8 = f.bytes.at(f.position); let isZ: bool = firstByte==90u8;
        var row = rowTokens(&f,not isZ); if (not f.valid) return failed("FORMAT",f.line);
        var tag = take(&row);
        if (eq(tag.asSlice(),"Z")) {
            let count: i64 = parseInteger(&row,0i64,2147483646i64); let expected: u32 = readWord(&row);
            if (not row.valid or row.index!=row.values.length() or count!=result.value.records.length()+2i64 or result.value.records.length()==0i64) return failed("FORMAT",f.line);
            if (f.position!=f.bytes.length()) return failed("FORMAT",f.line+1i64);
            if ((f.crc^4294967295u32)!=expected) return failed("CHECKSUM",f.line);
            if (inInitial) result.value.initialCount = result.value.records.length(); complete = true;
        } else {
            if (result.value.records.length()+3i64>limits.maxRecords) return failed("LIMIT",0i64);
            var e = Entry();
            if (eq(tag.asSlice(),"I")) { if (not inInitial) return failed("FORMAT",f.line); e.kind = 0i32; }
            else if (eq(tag.asSlice(),"C") or eq(tag.asSlice(),"T")) { if (inInitial) { result.value.initialCount = result.value.records.length(); inInitial = false; } e.kind = if eq(tag.asSlice(),"T") then 2i32 else 1i32; e.tick = parseInteger(&row,0i64,9223372036854775807i64); if (e.tick!=tickIndex) return failed("FORMAT",f.line); }
            else return failed("FORMAT",f.line);
            let sequence: i64 = parseInteger(&row,0i64,2147483646i64); if (sequence!=result.value.records.length()) return failed("FORMAT",f.line);
            if (e.kind!=2i32) {
                var function = take(&row); e.operation = operationCode(function.asSlice()); if (e.operation<0i32 or e.operation==0i32 and sequence!=0i64 or sequence==0i64 and (e.operation!=0i32 or e.kind!=0i32)) return failed("FORMAT",f.line);
                let argc: i64 = parseInteger(&row,0i64,row.values.length()-row.index); var ai: i64 = 0i64; while (ai<argc and row.valid) { e.args.push(take(&row)); ai += 1i64; }
                var dummy = Recording(); dummy.tape.settings = result.value.settings; let check = execute(&dummy,&e,false); if (check.status!=game.OK) return failed("FORMAT",f.line);
            }
            e.status = parseInteger(&row,0i64,7i64) as i32; e.reason = parseInteger(&row,-2147483648i64,2147483647i64) as i32;
            if (e.kind==2i32) { if (sequence==0i64) return failed("FORMAT",f.line); if (e.status==game.OK) tickIndex += 1i64; }
            else {
                let n: i64 = parseInteger(&row,0i64,limits.maxObjects); if (n>limits.maxObjects-(nextSerial-1i64)) return failed("LIMIT",0i64);
                var expectedCount: i64 = reservedObjects(&e);


                if (e.operation==61i32) { var p = Reader(); p.values = copy e.args; readHistorical(&p); var d = game.ChainDescription(); read_game_ChainDescription(&p,&d); expectedCount = 1i64+(if d.isLoop then d.points.length() else (if d.points.length()>3i64 then d.points.length()-3i64 else 0i64)); }

                if (e.status!=game.OK) expectedCount = 0i64;
                if (n!=expectedCount) return failed("FORMAT",f.line);
                var ni: i64 = 0i64; while (ni<n and row.valid) { let serial: i64 = parseInteger(&row,1i64,limits.maxObjects); if (serial!=nextSerial) return failed("FORMAT",f.line); e.created.push(serial); nextSerial += 1i64; ni += 1i64; }
            }
            if (not row.valid or row.index!=row.values.length()) return failed("FORMAT",f.line);
            if (sequence==0i64) {
                if (e.status!=game.OK) return failed("FORMAT",f.line);
                # Read configuration without creating a world.
                var p = Reader(); p.values = copy e.args;
                read_Vec2(&p,&result.value.settings.physics.gravity);
                result.value.settings.physics.maximumLinearSpeed = fromBits(readWord(&p)); result.value.settings.physics.contactHertz = fromBits(readWord(&p)); result.value.settings.physics.contactDampingRatio = fromBits(readWord(&p));
                result.value.settings.physics.maxContactPushSpeed = fromBits(readWord(&p)); result.value.settings.physics.restitutionThreshold = fromBits(readWord(&p)); result.value.settings.physics.hitEventThreshold = fromBits(readWord(&p));
                result.value.settings.physics.enableWarmStarting = parseInteger(&p,0i64,1i64)==1i64; result.value.settings.enableSleeping = parseInteger(&p,0i64,1i64)==1i64; result.value.settings.enableContinuous = parseInteger(&p,0i64,1i64)==1i64; result.value.settings.physics.enableContinuous = result.value.settings.enableContinuous;
                if (not game.validSolverWorldParameters(result.value.settings.physics)) return failed("FORMAT",f.line);
            }
            result.value.records.push(move e);
        }
    }
    result.value.valid = true; return result;
}
extern("C") {
    fundecl fopen(path: cptr char,mode: cptr char) -> cptr u8;
    fundecl fgetc(file: cptr u8) -> i32;
    fundecl ferror(file: cptr u8) -> i32;
    fundecl fclose(file: cptr u8) -> i32;
    fundecl fwrite(data: cptr u8,size: u64,count: u64,file: cptr u8) -> u64;
    fundecl remove(path: cptr char) -> i32;
}
fun cString(s: ref String) -> cptr char = { return builtins.ptr_from_slice[char](s.asSlice()) as cptr char; }
fun nullFile(value: cptr u8) -> bool = { var p: cptr u8 = value; return (&p as cptr u64)[0]==0u64; }
fun validPath(path: str) -> bool = { let p: cptr char = builtins.ptr_from_slice[char](path) as cptr char; var i: i64 = 0i64; while (i<path.length()) { if (p[i]=='\0') return false; i += 1i64; } return true; }
fun load(path: str,applicationVersion: str,limits: TapeLimits = TapeLimits()) -> TapeLoad = {
    if (not validLimits(limits) or not validApplication(applicationVersion) or not validPath(path)) return TapeLoad(game.PARAM);
    var name = text(path); name.append('\0'); var file: cptr u8 = fopen(cString(&name),builtins.ptr_from_slice[char]("rb\0") as cptr char); if (nullFile(file)) return failed("IO",0i64);
    var bytes: List[u8]; var c: i32 = fgetc(file); while (c>=0i32 and bytes.length()<=limits.maxBytes) { bytes.push(c as u8); c = fgetc(file); }
    let error: i32 = ferror(file); let closed: i32 = fclose(file); if (error!=0i32 or closed!=0i32) return failed("IO",0i64); if (bytes.length()>limits.maxBytes) return failed("LIMIT",0i64); return decode(&bytes,applicationVersion,limits);
}
fun save(path: str,tape: ref Tape) -> TapeAction = {
    if (not validPath(path)) return TapeAction(game.PARAM); var encoded = encode(tape); if (encoded.status!=game.OK) return TapeAction(encoded.status,encoded.reason);
    var validated = decode(&encoded.values,tape.application.asSlice(),tape.limits); if (validated.status!=game.OK) return TapeAction(validated.status,validated.reason);
    var target = text(path); target.append('\0'); var temporary = text(path); temporary.append(".r5-XXXXXX\0");
    var file: cptr u8;
    if (not platform.openTemporary(&temporary,&file)) return TapeAction(IO);
    if (nullFile(file)) { remove(cString(&temporary)); return TapeAction(IO); }
    let written: u64 = fwrite(encoded.values.pointer as cptr u8,1u64,encoded.values.length() as u64,file); let closed: i32 = fclose(file);
    if (written!=encoded.values.length() as u64 or closed!=0i32) { remove(cString(&temporary)); return TapeAction(IO); }
    let replaced: bool = platform.replace(cString(&temporary),cString(&target));
    if (not replaced) { remove(cString(&temporary)); return TapeAction(IO); } return TapeAction();
}



# Owned, labelled public observations; no pointer or process ticket enters comparison.
import fizyka.drzewo as tree;
class Observation { serial: i64 = 0i64; field: String = stringReserve(0i64); value: String = stringReserve(0i64); }
fun observations() -> List[Observation] = { var v: List[Observation]; return v; }
class RecordedState { status: i32 = 0i32; reason: i32 = 0i32; tick: i64 = 0i64; engine: str = ENGINE64; compiler: str = COMPILER40;
    application: String = stringReserve(0i64); values: List[Observation] = observations(); }
class StateComparison { status: i32 = 0i32; reason: i32 = 0i32; equal: bool = true; tick: i64 = -1i64; serial: i64 = 0i64; field: str = ""; }
fun observe(s: ref RecordedState,serial: i64,field: str,value: String) -> () = { s.values.push(Observation(serial,text(field),move value)); }
fun contactsBank() -> List[game.ContactNumber] = { var v: List[game.ContactNumber]; return v; }
fun contactSerial(r: ref Recording,n: game.ContactNumber) -> i64 = { var i: i64 = 0i64; while (i<r.contactMap.length()) { let old: game.ContactNumber = r.contactMap.at(i); if (old.slot==n.slot and game.equalKey(old.birthTicket,n.birthTicket) and game.equalKey(old.ownerTicket,n.ownerTicket)) return i+1i64; i += 1i64; } r.contactMap.push(n); return r.contactMap.length(); }
fun rememberContacts(r: ref Recording) -> () = { var i: i64 = 0i64; while (i<r.map.length()) { var m: ref Mapping = r.map.at(i); if (m.kind==1i32 and game.bodyStatus(r.gameSession.world,m.body)==game.OK) { var c = game.contacts(r.gameSession.world,m.body); var j: i64 = 0i64; while (j<c.values.length()) { contactSerial(r,c.values.at(j).number); j += 1i64; } } i += 1i64; } }


fun obs_Vec2(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref Vec2) -> () = { observe(s,serial,observationPath(field,"x").asSlice(),word(floatBits(v.x))); observe(s,serial,observationPath(field,"y").asSlice(),word(floatBits(v.y))); }

fun obs_game_SolverWorldParameters(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SolverWorldParameters) -> () = { obs_Vec2(s,r,serial,observationPath(field,"gravity").asSlice(),&v.gravity); observe(s,serial,observationPath(field,"maximumLinearSpeed").asSlice(),word(floatBits(v.maximumLinearSpeed))); observe(s,serial,observationPath(field,"contactHertz").asSlice(),word(floatBits(v.contactHertz))); observe(s,serial,observationPath(field,"contactDampingRatio").asSlice(),word(floatBits(v.contactDampingRatio))); observe(s,serial,observationPath(field,"maxContactPushSpeed").asSlice(),word(floatBits(v.maxContactPushSpeed))); observe(s,serial,observationPath(field,"restitutionThreshold").asSlice(),word(floatBits(v.restitutionThreshold))); observe(s,serial,observationPath(field,"hitEventThreshold").asSlice(),word(floatBits(v.hitEventThreshold))); observe(s,serial,observationPath(field,"enableWarmStarting").asSlice(),decimal(if v.enableWarmStarting then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enableContinuous").asSlice(),decimal(if v.enableContinuous then 1i64 else 0i64)); }

fun obs_start_GameSettings(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref start.GameSettings) -> () = { obs_game_SolverWorldParameters(s,r,serial,observationPath(field,"physics").asSlice(),&v.physics); observe(s,serial,observationPath(field,"enableSleeping").asSlice(),decimal(if v.enableSleeping then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enableContinuous").asSlice(),decimal(if v.enableContinuous then 1i64 else 0i64)); observe(s,serial,observationPath(field,"stepsPerSecond").asSlice(),decimal(v.stepsPerSecond as i64)); observe(s,serial,observationPath(field,"subStepCount").asSlice(),decimal(v.subStepCount as i64)); observe(s,serial,observationPath(field,"maxStepsPerFrame").asSlice(),decimal(v.maxStepsPerFrame as i64)); observe(s,serial,observationPath(field,"pixelsPerMetre").asSlice(),word(floatBits(v.pixelsPerMetre))); obs_Vec2(s,r,serial,observationPath(field,"screenOrigin").asSlice(),&v.screenOrigin); }

fun obs_Key64(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref Key64) -> () = { observe(s,serial,observationPath(field,"low").asSlice(),decimal(v.low as i64)); observe(s,serial,observationPath(field,"high").asSlice(),decimal(v.high as i64)); }

fun obs_raw_WorldView(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref raw.WorldView) -> () = { obs_Vec2(s,r,serial,observationPath(field,"gravity").asSlice(),&v.gravity); observe(s,serial,observationPath(field,"maximumLinearSpeed").asSlice(),word(floatBits(v.maximumLinearSpeed))); observe(s,serial,observationPath(field,"bodyCount").asSlice(),decimal(v.bodyCount as i64)); observe(s,serial,observationPath(field,"shapeCount").asSlice(),decimal(v.shapeCount as i64)); observe(s,serial,observationPath(field,"islandCount").asSlice(),decimal(v.islandCount as i64)); observe(s,serial,observationPath(field,"restitutionThreshold").asSlice(),word(floatBits(v.restitutionThreshold))); observe(s,serial,observationPath(field,"hitEventThreshold").asSlice(),word(floatBits(v.hitEventThreshold))); observe(s,serial,observationPath(field,"warmStartingEnabled").asSlice(),decimal(if v.warmStartingEnabled then 1i64 else 0i64)); observe(s,serial,observationPath(field,"sleepingEnabled").asSlice(),decimal(if v.sleepingEnabled then 1i64 else 0i64)); observe(s,serial,observationPath(field,"awakeBodyCount").asSlice(),decimal(v.awakeBodyCount as i64)); observe(s,serial,observationPath(field,"hasObjectId").asSlice(),decimal(if v.hasObjectId then 1i64 else 0i64)); obs_Key64(s,r,serial,observationPath(field,"objectId").asSlice(),&v.objectId); }

fun obs_Rot(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref Rot) -> () = { observe(s,serial,observationPath(field,"c").asSlice(),word(floatBits(v.c))); observe(s,serial,observationPath(field,"s").asSlice(),word(floatBits(v.s))); }

fun obs_Transform(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref Transform) -> () = { obs_Vec2(s,r,serial,observationPath(field,"p").asSlice(),&v.p); obs_Rot(s,r,serial,observationPath(field,"q").asSlice(),&v.q); }

fun obs_raw_NameValue(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref raw.NameValue) -> () = { observe(s,serial,observationPath(field,"length").asSlice(),decimal(v.length as i64)); observe(s,serial,observationPath(field,"bytes[0]").asSlice(),decimal(v.bytes[0i32] as i64)); observe(s,serial,observationPath(field,"bytes[1]").asSlice(),decimal(v.bytes[1i32] as i64)); observe(s,serial,observationPath(field,"bytes[2]").asSlice(),decimal(v.bytes[2i32] as i64)); observe(s,serial,observationPath(field,"bytes[3]").asSlice(),decimal(v.bytes[3i32] as i64)); observe(s,serial,observationPath(field,"bytes[4]").asSlice(),decimal(v.bytes[4i32] as i64)); observe(s,serial,observationPath(field,"bytes[5]").asSlice(),decimal(v.bytes[5i32] as i64)); observe(s,serial,observationPath(field,"bytes[6]").asSlice(),decimal(v.bytes[6i32] as i64)); observe(s,serial,observationPath(field,"bytes[7]").asSlice(),decimal(v.bytes[7i32] as i64)); observe(s,serial,observationPath(field,"bytes[8]").asSlice(),decimal(v.bytes[8i32] as i64)); observe(s,serial,observationPath(field,"bytes[9]").asSlice(),decimal(v.bytes[9i32] as i64)); observe(s,serial,observationPath(field,"bytes[10]").asSlice(),decimal(v.bytes[10i32] as i64)); observe(s,serial,observationPath(field,"bytes[11]").asSlice(),decimal(v.bytes[11i32] as i64)); observe(s,serial,observationPath(field,"bytes[12]").asSlice(),decimal(v.bytes[12i32] as i64)); observe(s,serial,observationPath(field,"bytes[13]").asSlice(),decimal(v.bytes[13i32] as i64)); observe(s,serial,observationPath(field,"bytes[14]").asSlice(),decimal(v.bytes[14i32] as i64)); observe(s,serial,observationPath(field,"bytes[15]").asSlice(),decimal(v.bytes[15i32] as i64)); observe(s,serial,observationPath(field,"bytes[16]").asSlice(),decimal(v.bytes[16i32] as i64)); observe(s,serial,observationPath(field,"bytes[17]").asSlice(),decimal(v.bytes[17i32] as i64)); observe(s,serial,observationPath(field,"bytes[18]").asSlice(),decimal(v.bytes[18i32] as i64)); observe(s,serial,observationPath(field,"bytes[19]").asSlice(),decimal(v.bytes[19i32] as i64)); observe(s,serial,observationPath(field,"bytes[20]").asSlice(),decimal(v.bytes[20i32] as i64)); observe(s,serial,observationPath(field,"bytes[21]").asSlice(),decimal(v.bytes[21i32] as i64)); observe(s,serial,observationPath(field,"bytes[22]").asSlice(),decimal(v.bytes[22i32] as i64)); observe(s,serial,observationPath(field,"bytes[23]").asSlice(),decimal(v.bytes[23i32] as i64)); observe(s,serial,observationPath(field,"bytes[24]").asSlice(),decimal(v.bytes[24i32] as i64)); observe(s,serial,observationPath(field,"bytes[25]").asSlice(),decimal(v.bytes[25i32] as i64)); observe(s,serial,observationPath(field,"bytes[26]").asSlice(),decimal(v.bytes[26i32] as i64)); observe(s,serial,observationPath(field,"bytes[27]").asSlice(),decimal(v.bytes[27i32] as i64)); observe(s,serial,observationPath(field,"bytes[28]").asSlice(),decimal(v.bytes[28i32] as i64)); observe(s,serial,observationPath(field,"bytes[29]").asSlice(),decimal(v.bytes[29i32] as i64)); observe(s,serial,observationPath(field,"bytes[30]").asSlice(),decimal(v.bytes[30i32] as i64)); observe(s,serial,observationPath(field,"bytes[31]").asSlice(),decimal(v.bytes[31i32] as i64)); }

fun obs_raw_BodyView(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref raw.BodyView) -> () = { observe(s,serial,observationPath(field,"bodyType").asSlice(),decimal(v.bodyType as i64)); obs_Transform(s,r,serial,observationPath(field,"transform").asSlice(),&v.transform); obs_Vec2(s,r,serial,observationPath(field,"center").asSlice(),&v.center); obs_Vec2(s,r,serial,observationPath(field,"linearVelocity").asSlice(),&v.linearVelocity); observe(s,serial,observationPath(field,"angularVelocity").asSlice(),word(floatBits(v.angularVelocity))); observe(s,serial,observationPath(field,"mass").asSlice(),word(floatBits(v.mass))); observe(s,serial,observationPath(field,"inertia").asSlice(),word(floatBits(v.inertia))); obs_Vec2(s,r,serial,observationPath(field,"localCenter").asSlice(),&v.localCenter); observe(s,serial,observationPath(field,"shapeCount").asSlice(),decimal(v.shapeCount as i64)); observe(s,serial,observationPath(field,"isAwake").asSlice(),decimal(if v.isAwake then 1i64 else 0i64)); observe(s,serial,observationPath(field,"isEnabled").asSlice(),decimal(if v.isEnabled then 1i64 else 0i64)); observe(s,serial,observationPath(field,"fixedRotation").asSlice(),decimal(if v.fixedRotation then 1i64 else 0i64)); observe(s,serial,observationPath(field,"hasObjectId").asSlice(),decimal(if v.hasObjectId then 1i64 else 0i64)); obs_Key64(s,r,serial,observationPath(field,"objectId").asSlice(),&v.objectId); obs_raw_NameValue(s,r,serial,observationPath(field,"name").asSlice(),&v.name); }

fun obs_game_SleepState(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SleepState) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); observe(s,serial,observationPath(field,"number").asSlice(),decimal(bodySerial(r,v.number))); observe(s,serial,observationPath(field,"isAwake").asSlice(),decimal(if v.isAwake then 1i64 else 0i64)); observe(s,serial,observationPath(field,"isSleeping").asSlice(),decimal(if v.isSleeping then 1i64 else 0i64)); observe(s,serial,observationPath(field,"sleepEnabled").asSlice(),decimal(if v.sleepEnabled then 1i64 else 0i64)); observe(s,serial,observationPath(field,"sleepThreshold").asSlice(),word(floatBits(v.sleepThreshold))); }

fun obs_broad_ShapeFilter(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref broad.ShapeFilter) -> () = { observe(s,serial,observationPath(field,"categoryBits").asSlice(),decimal(v.categoryBits as i64)); observe(s,serial,observationPath(field,"maskBits").asSlice(),decimal(v.maskBits as i64)); observe(s,serial,observationPath(field,"groupIndex").asSlice(),decimal(v.groupIndex as i64)); }

fun obs_tree_AABB(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref tree.AABB) -> () = { obs_Vec2(s,r,serial,observationPath(field,"lowerBound").asSlice(),&v.lowerBound); obs_Vec2(s,r,serial,observationPath(field,"upperBound").asSlice(),&v.upperBound); }

fun obs_raw_ShapeRecord(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref raw.ShapeRecord) -> () = { observe(s,serial,observationPath(field,"shapeType").asSlice(),decimal(v.shapeType as i64)); if (v.shapeType==0i32) { var tokens = strings(); pack_circle(&tokens,&v.circle,r.session); var gi: i64 = 0i64; while (gi<tokens.length()) { observe(s,serial,observationPath(field,"shape.circle").asSlice(),copy tokens.at(gi)); gi += 1i64; } } if (v.shapeType==1i32) { var tokens = strings(); pack_capsule(&tokens,&v.capsule,r.session); var gi: i64 = 0i64; while (gi<tokens.length()) { observe(s,serial,observationPath(field,"shape.capsule").asSlice(),copy tokens.at(gi)); gi += 1i64; } } if (v.shapeType==2i32) { var tokens = strings(); pack_segment(&tokens,&v.segment,r.session); var gi: i64 = 0i64; while (gi<tokens.length()) { observe(s,serial,observationPath(field,"shape.segment").asSlice(),copy tokens.at(gi)); gi += 1i64; } } if (v.shapeType==4i32) { var tokens = strings(); pack_chainSegment(&tokens,&v.chainSegment,r.session); var gi: i64 = 0i64; while (gi<tokens.length()) { observe(s,serial,observationPath(field,"shape.chainSegment").asSlice(),copy tokens.at(gi)); gi += 1i64; } } observe(s,serial,observationPath(field,"enableSensorEvents").asSlice(),decimal(if v.enableSensorEvents then 1i64 else 0i64)); observe(s,serial,observationPath(field,"isSensor").asSlice(),decimal(if v.isSensor then 1i64 else 0i64)); if (v.shapeType==3i32) { var tokens = strings(); pack_polygon(&tokens,&v.polygon,r.session); var gi: i64 = 0i64; while (gi<tokens.length()) { observe(s,serial,observationPath(field,"shape.polygon").asSlice(),copy tokens.at(gi)); gi += 1i64; } } observe(s,serial,observationPath(field,"density").asSlice(),word(floatBits(v.density))); observe(s,serial,observationPath(field,"friction").asSlice(),word(floatBits(v.friction))); observe(s,serial,observationPath(field,"restitution").asSlice(),word(floatBits(v.restitution))); observe(s,serial,observationPath(field,"rollingResistance").asSlice(),word(floatBits(v.rollingResistance))); observe(s,serial,observationPath(field,"tangentSpeed").asSlice(),word(floatBits(v.tangentSpeed))); observe(s,serial,observationPath(field,"userMaterialId").asSlice(),decimal(v.userMaterialId as i64)); observe(s,serial,observationPath(field,"customColor").asSlice(),decimal(v.customColor as i64)); obs_broad_ShapeFilter(s,r,serial,observationPath(field,"filter").asSlice(),&v.filter); obs_tree_AABB(s,r,serial,observationPath(field,"aabb").asSlice(),&v.aabb); observe(s,serial,observationPath(field,"enableContactEvents").asSlice(),decimal(if v.enableContactEvents then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enableHitEvents").asSlice(),decimal(if v.enableHitEvents then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enablePreSolveEvents").asSlice(),decimal(if v.enablePreSolveEvents then 1i64 else 0i64)); observe(s,serial,observationPath(field,"hasObjectId").asSlice(),decimal(if v.hasObjectId then 1i64 else 0i64)); obs_Key64(s,r,serial,observationPath(field,"objectId").asSlice(),&v.objectId); }

fun obs_List_game_ShapeNumber_(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref List[game.ShapeNumber]) -> () = { observe(s,serial,field,decimal(v.length())); var i: i64 = 0i64; while (i<v.length()) { var item: game.ShapeNumber = copy v.at(i); observe(s,serial,observationIndex(field,i).asSlice(),decimal(shapeSerial(r,item))); i += 1i64; } }

fun obs_game_ChainView(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.ChainView) -> () = { observe(s,serial,observationPath(field,"number").asSlice(),decimal(chainSerial(r,v.number))); observe(s,serial,observationPath(field,"body").asSlice(),decimal(bodySerial(r,v.body))); obs_List_game_ShapeNumber_(s,r,serial,observationPath(field,"segments").asSlice(),&v.segments); }

