fun obs_game_ContactHit(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.ContactHit) -> () = { observe(s,serial,observationPath(field,"shapeA").asSlice(),decimal(shapeSerial(r,v.shapeA))); observe(s,serial,observationPath(field,"shapeB").asSlice(),decimal(shapeSerial(r,v.shapeB))); obs_Vec2(s,r,serial,observationPath(field,"point").asSlice(),&v.point); obs_Vec2(s,r,serial,observationPath(field,"normal").asSlice(),&v.normal); observe(s,serial,observationPath(field,"approachSpeed").asSlice(),word(floatBits(v.approachSpeed))); }

fun obs_List_game_ContactHit_(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref List[game.ContactHit]) -> () = { observe(s,serial,field,decimal(v.length())); var i: i64 = 0i64; while (i<v.length()) { var item: game.ContactHit = copy v.at(i); obs_game_ContactHit(s,r,serial,observationIndex(field,i).asSlice(),&item); i += 1i64; } }

fun obs_game_ContactEvents(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.ContactEvents) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); obs_List_game_ContactBegin_(s,r,serial,observationPath(field,"begin").asSlice(),&v.begin); obs_List_game_ContactEnd_(s,r,serial,observationPath(field,"end").asSlice(),&v.end); observe(s,serial,observationPath(field,"hitCount").asSlice(),decimal(v.hitCount as i64)); obs_List_game_ContactHit_(s,r,serial,observationPath(field,"hits").asSlice(),&v.hits); }

fun obs_game_SensorTouch(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SensorTouch) -> () = { observe(s,serial,observationPath(field,"sensor").asSlice(),decimal(shapeSerial(r,v.sensor))); observe(s,serial,observationPath(field,"visitor").asSlice(),decimal(shapeSerial(r,v.visitor))); }

fun obs_List_game_SensorTouch_(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref List[game.SensorTouch]) -> () = { observe(s,serial,field,decimal(v.length())); var i: i64 = 0i64; while (i<v.length()) { var item: game.SensorTouch = copy v.at(i); obs_game_SensorTouch(s,r,serial,observationIndex(field,i).asSlice(),&item); i += 1i64; } }

fun obs_game_SensorEventCopy(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SensorEventCopy) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); observe(s,serial,observationPath(field,"reason").asSlice(),decimal(v.reason as i64)); obs_List_game_SensorTouch_(s,r,serial,observationPath(field,"beginEvents").asSlice(),&v.beginEvents); obs_List_game_SensorTouch_(s,r,serial,observationPath(field,"endEvents").asSlice(),&v.endEvents); }

fun obs_game_SensorOverlap(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SensorOverlap) -> () = { observe(s,serial,observationPath(field,"number").asSlice(),decimal(shapeSerial(r,v.number))); }

fun obs_List_game_SensorOverlap_(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref List[game.SensorOverlap]) -> () = { observe(s,serial,field,decimal(v.length())); var i: i64 = 0i64; while (i<v.length()) { var item: game.SensorOverlap = copy v.at(i); obs_game_SensorOverlap(s,r,serial,observationIndex(field,i).asSlice(),&item); i += 1i64; } }

fun obs_game_SensorOverlaps(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.SensorOverlaps) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); observe(s,serial,observationPath(field,"reason").asSlice(),decimal(v.reason as i64)); obs_List_game_SensorOverlap_(s,r,serial,observationPath(field,"values").asSlice(),&v.values); }

fun capture(recording: ref Recording) -> RecordedState = {
    var result = RecordedState(); if (recording.phase==0i32) return RecordedState(game.STALE);
    result.status = game.worldStatus(recording.gameSession.world); if (result.status!=game.OK) return result;
    result.tick = recording.gameSession.stepIndex; result.application = copy recording.tape.application;
    var world = game.lookupWorld(recording.gameSession.world); result.status = world.status; if (world.status!=game.OK) return result;
    obs_start_GameSettings(&result,recording,0i64,"configuration",&recording.tape.settings);
    obs_raw_WorldView(&result,recording,0i64,"world",&world.value);
    var continuous = game.isContinuousEnabled(recording.gameSession.world); observe(&result,0i64,"continuous",decimal(if continuous.value then 1i64 else 0i64));
    captureMetadata(&result,recording);
    var i: i64 = 0i64; while (i<recording.map.length()) {
        var mapped: ref Mapping = recording.map.at(i); let serial: i64 = i+1i64;
        let alive: i32 = mappingStatus(recording,Historical(serial,false),mapped.kind); observe(&result,serial,"alive",decimal(alive as i64));
        if (alive==game.OK) {
            if (mapped.kind==1i32) {
                var body = game.lookupBody(recording.gameSession.world,mapped.body); obs_raw_BodyView(&result,recording,serial,"body",&body.value);
                var sleep = game.getSleepState(recording.gameSession.world,mapped.body); obs_game_SleepState(&result,recording,serial,"sleep",&sleep);
                var bullet = game.isBullet(recording.gameSession.world,mapped.body); observe(&result,serial,"isBullet",decimal(if bullet.value then 1i64 else 0i64));
                var shapes = game.getShapes(recording.gameSession.world,mapped.body); obs_game_ShapeList(&result,recording,serial,"shapes",&shapes);
                var joints = game.bodyJoints(recording.gameSession.world,mapped.body); obs_game_JointList(&result,recording,serial,"joints",&joints);
                var contacts = game.contacts(recording.gameSession.world,mapped.body); obs_game_ContactList(&result,recording,serial,"contacts",&contacts);
            }
            if (mapped.kind==2i32) {
                var shape = game.lookupShape(recording.gameSession.world,mapped.shape); obs_raw_ShapeRecord(&result,recording,serial,"shape",&shape.value);
                var sensor = game.isSensor(recording.gameSession.world,mapped.shape);
                if (sensor.status==game.OK and sensor.value==1i32) { var overlaps = game.sensorOverlaps(recording.gameSession.world,mapped.shape); obs_game_SensorOverlaps(&result,recording,serial,"overlaps",&overlaps); }
            }
            if (mapped.kind==3i32) { captureChainDescription(&result,recording,serial); var chain = game.lookupChain(recording.gameSession.world,mapped.chain); obs_game_ChainView(&result,recording,serial,"chain",&chain.value); }
            if (mapped.kind==5i32) captureCharacter(&result,recording,serial,mapped);
            if (mapped.kind==4i32) { var joint = game.lookupJoint(recording.gameSession.world,mapped.joint); obs_game_JointView(&result,recording,serial,"joint",&joint.value); }
        }
        i += 1i64;
    }
    # Preserve public event order and historical references even after destruction.
    var events = game.copyContactEvents(recording.gameSession.world); obs_game_ContactEvents(&result,recording,0i64,"events",&events);
    var sensors = game.copySensorEvents(recording.gameSession.world); obs_game_SensorEventCopy(&result,recording,0i64,"sensorEvents",&sensors);
    var mi: i64 = 0i64; observe(&result,0i64,"moves.count",decimal(recording.lastStep.values.length()));
    while (mi<recording.lastStep.values.length()) { var m: ref TapeMove = recording.lastStep.values.at(mi); observe(&result,m.number.serial,"move.number",decimal(m.number.serial)); obs_Transform(&result,recording,m.number.serial,"move.transform",&m.transform); obs_Key64(&result,recording,m.number.serial,"move.objectId",&m.objectId); observe(&result,m.number.serial,"move.hasObjectId",decimal(if m.hasObjectId then 1i64 else 0i64)); observe(&result,m.number.serial,"move.fellAsleep",decimal(if m.fellAsleep then 1i64 else 0i64)); mi += 1i64; }
    orderObservations(&result.values); return result;
}
fun compare(a: ref RecordedState,b: ref RecordedState) -> StateComparison = {
    if (a.status!=game.OK) return StateComparison(a.status,a.reason,false);
    if (b.status!=game.OK) return StateComparison(b.status,b.reason,false);
    if (not eq(a.engine,b.engine) or not eq(a.compiler,b.compiler) or not eq(a.application.asSlice(),b.application.asSlice())) return StateComparison(VERSION,0i32,false,-1i64,0i64,"version");
    if (a.tick!=b.tick) return StateComparison(DIVERGED,0i32,false,if a.tick<b.tick then a.tick else b.tick,0i64,"tick");
    var i: i64 = 0i64; while (i<a.values.length() and i<b.values.length()) { var x: ref Observation = a.values.at(i); var y: ref Observation = b.values.at(i);
        if (x.serial!=y.serial or not eq(x.field.asSlice(),y.field.asSlice()) or not eq(x.value.asSlice(),y.value.asSlice())) return StateComparison(DIVERGED,0i32,false,a.tick,x.serial,x.field.asSlice()); i += 1i64; }
    if (a.values.length()!=b.values.length()) return StateComparison(DIVERGED,0i32,false,a.tick,0i64,"length"); return StateComparison();
}


fun captureMetadata(s: ref RecordedState,r: ref Recording) -> () = { var total: i64 = if r.phase>=4i32 then r.cursor else r.tape.records.length();
var contactHertz: f32 = r.tape.settings.physics.contactHertz;
var contactDampingRatio: f32 = r.tape.settings.physics.contactDampingRatio;
var maxContactPushSpeed: f32 = r.tape.settings.physics.maxContactPushSpeed;
var tablePair = strings(); var flagPair: bool = false;
var tablePreSolve = strings(); var flagPreSolve: bool = false;
var tableFriction = strings(); var flagFriction: bool = false;
var tableRestitution = strings(); var flagRestitution: bool = false;
var index: i64 = 0i64; while (index<total) { var e: ref Entry = r.tape.records.at(index); if (e.kind!=2i32 and e.status==game.OK) {
if (e.operation==47i32) { var reader = Reader(); reader.values = copy e.args; contactHertz = fromBits(readWord(&reader)); contactDampingRatio = fromBits(readWord(&reader)); maxContactPushSpeed = fromBits(readWord(&reader)); }
if (e.operation==53i32) { tablePair.clear(); var ti: i64 = 1i64; while (ti<e.args.length()) { tablePair.push(copy e.args.at(ti)); ti += 1i64; } }
if (e.operation==85i32) { var ai: i64 = 0i64; while (ai<e.args.length()) { tablePair.push(copy e.args.at(ai)); ai += 1i64; } }
if (e.operation==57i32) flagPair = eq(e.args.at(0i64).asSlice(),"1");
if (e.operation==54i32) { tablePreSolve.clear(); var ti: i64 = 1i64; while (ti<e.args.length()) { tablePreSolve.push(copy e.args.at(ti)); ti += 1i64; } }
if (e.operation==86i32) { var ai: i64 = 0i64; while (ai<e.args.length()) { tablePreSolve.push(copy e.args.at(ai)); ai += 1i64; } }
if (e.operation==58i32) flagPreSolve = eq(e.args.at(0i64).asSlice(),"1");
if (e.operation==55i32) { tableFriction.clear(); var ti: i64 = 1i64; while (ti<e.args.length()) { tableFriction.push(copy e.args.at(ti)); ti += 1i64; } }
if (e.operation==84i32) { var ai: i64 = 0i64; while (ai<e.args.length()) { tableFriction.push(copy e.args.at(ai)); ai += 1i64; } }
if (e.operation==59i32) flagFriction = eq(e.args.at(0i64).asSlice(),"1");
if (e.operation==56i32) { tableRestitution.clear(); var ti: i64 = 1i64; while (ti<e.args.length()) { tableRestitution.push(copy e.args.at(ti)); ti += 1i64; } }
if (e.operation==87i32) { var ai: i64 = 0i64; while (ai<e.args.length()) { tableRestitution.push(copy e.args.at(ai)); ai += 1i64; } }
if (e.operation==60i32) flagRestitution = eq(e.args.at(0i64).asSlice(),"1");
} index += 1i64; }
observe(s,0i64,"contactHertz",word(floatBits(contactHertz)));
observe(s,0i64,"contactDampingRatio",word(floatBits(contactDampingRatio)));
observe(s,0i64,"maxContactPushSpeed",word(floatBits(maxContactPushSpeed)));
observe(s,0i64,"Pair.enabled",decimal(if flagPair then 1i64 else 0i64)); observe(s,0i64,"Pair.tokens",decimal(tablePair.length())); var tPair: i64 = 0i64; while (tPair<tablePair.length()) { observe(s,0i64,"Pair.rule",copy tablePair.at(tPair)); tPair += 1i64; }
observe(s,0i64,"PreSolve.enabled",decimal(if flagPreSolve then 1i64 else 0i64)); observe(s,0i64,"PreSolve.tokens",decimal(tablePreSolve.length())); var tPreSolve: i64 = 0i64; while (tPreSolve<tablePreSolve.length()) { observe(s,0i64,"PreSolve.rule",copy tablePreSolve.at(tPreSolve)); tPreSolve += 1i64; }
observe(s,0i64,"Friction.enabled",decimal(if flagFriction then 1i64 else 0i64)); observe(s,0i64,"Friction.tokens",decimal(tableFriction.length())); var tFriction: i64 = 0i64; while (tFriction<tableFriction.length()) { observe(s,0i64,"Friction.rule",copy tableFriction.at(tFriction)); tFriction += 1i64; }
observe(s,0i64,"Restitution.enabled",decimal(if flagRestitution then 1i64 else 0i64)); observe(s,0i64,"Restitution.tokens",decimal(tableRestitution.length())); var tRestitution: i64 = 0i64; while (tRestitution<tableRestitution.length()) { observe(s,0i64,"Restitution.rule",copy tableRestitution.at(tRestitution)); tRestitution += 1i64; }
}

# Labels own their bytes; compare borrows the label from its immutable input.
fun observationPath(parent: str,child: str) -> String = { var result = text(parent); if (result.length()>0i64) result.append('.'); result.append(child); return result; }
# Stable merge order preserves schema field/list order within each serial.
fun orderObservations(values: ref List[Observation]) -> () = {
    var scratch: List[Observation] = copy values; var width: i64 = 1i64; let n: i64 = values.length();
    while (width<n) { var base: i64 = 0i64;
        while (base<n) { let middle: i64 = if base+width<n then base+width else n; let end: i64 = if middle+width<n then middle+width else n;
            var left: i64 = base; var right: i64 = middle; var out: i64 = base;
            while (out<end) { if (left<middle and (right>=end or values.at(left).serial<=values.at(right).serial)) { scratch.at(out) = copy values.at(left); left += 1i64; }
                else { scratch.at(out) = copy values.at(right); right += 1i64; } out += 1i64; }
            base = end;
        }
        values = copy scratch; if (width>n/2i64) return; width *= 2i64;
    }
}
fun captureChainDescription(s: ref RecordedState,r: ref Recording,serial: i64) -> () = {
    var i: i64 = 0i64; while (i<r.tape.records.length()) { var e: ref Entry = r.tape.records.at(i);
        if (e.operation==61i32 and e.status==game.OK and e.created.length()>0i64 and e.created.at(0i64)==serial) {
            var j: i64 = 1i64; while (j<e.args.length()) { observe(s,serial,"chain.description",copy e.args.at(j)); j += 1i64; } return;
        } i += 1i64;
    }
}
fun observationIndex(parent: str,index: i64) -> String = { var result = text(parent); result.append('['); result.append(decimal(index)); result.append(']'); return result; }

# The character uses this history map, not a second tape or an image of Character memory.
fun characterSnapshot(r: ref Recording,value: hero.CharacterSnapshot) -> TapeCharacterSnapshot = {
    return TapeCharacterSnapshot(value.stepIndex,value.position,value.velocity,value.grounded,value.alive,value.jumpArmed,
        value.hasEnemy,TapeShape(shapeSerial(r,value.enemy),r.session),value.capsule);
}
fun executeCharacter(r: ref Recording,e: ref Entry,perform: bool) -> Execution = {
    var input = Reader(); input.values = copy e.args; var result = Execution();
    if (e.operation==143i32) {
        var points: List[Vec2]; read_List_Vec2_(&input,&points);
        if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT);
        if (not perform) return result;
        var floor = hero.addFloor(&r.gameSession,&points); result.status = floor.status; result.reason = floor.reason;
        if (result.status!=game.OK) return result;
        var body = Mapping(); body.kind = 1i32; body.body = floor.body.number; addMapping(r,body,e);
        var chain = Mapping(); chain.kind = 3i32; chain.chain = floor.chain.number; addMapping(r,chain,e);
        var segments = game.chainSegments(r.gameSession.world,floor.chain.number); var i: i64 = 0i64;
        while (i<segments.values.length()) { var shape = Mapping(); shape.kind = 2i32; shape.shape = segments.values.at(i); addMapping(r,shape,e); i += 1i64; }
        result.created = copy e.created; return result;
    }
    if (e.operation==144i32) {
        var position = Vec2(); read_Vec2(&input,&position); var settings = hero.CharacterSettings();
        settings.runSpeed = fromBits(readWord(&input)); settings.jumpSpeed = fromBits(readWord(&input));
        settings.gravity = fromBits(readWord(&input)); settings.maxFallSpeed = fromBits(readWord(&input));
        if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT);
        if (not perform) return result;
        var bound = hero.bindCharacter(&r.gameSession,position,settings); result.status = bound.status; result.reason = bound.reason;
        if (result.status!=game.OK) return result;
        var boundMapping = Mapping(); boundMapping.kind = 5i32; boundMapping.character = bound.value; addMapping(r,boundMapping,e);
        result.created = copy e.created; return result;
    }
    let number = readHistorical(&input); var enemy = Historical(); var intent = hero.CharacterInput();
    if (e.operation==145i32) enemy = readHistorical(&input);
    if (e.operation==146i32) { intent.axis = parseInteger(&input,-2147483648i64,2147483647i64) as i32; intent.jump = parseInteger(&input,0i64,1i64)==1i64; }
    if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT);
    if (not perform) return result;
    result.status = mappingStatus(r,number,5i32); if (result.status!=game.OK) return result;
    if (e.operation==145i32) {
        result.status = mappingStatus(r,enemy,2i32); if (result.status!=game.OK) return result;
        var watched = hero.watchEnemy(&r.gameSession,&r.map.at(number.serial-1i64).character,r.map.at(enemy.serial-1i64).shape);
        return Execution(watched.status,watched.reason);
    }
    var mapped: ref Mapping = r.map.at(number.serial-1i64);
    if (e.operation==146i32) { var accepted = hero.setCharacterInput(&r.gameSession,&mapped.character,intent); return Execution(accepted.status,accepted.reason); }
    var moved = hero.moveCharacterAfterStep(&r.gameSession,&mapped.character);
    result.status = moved.status; result.reason = moved.reason;
    if (result.status==game.OK) {
        mapped.jumped = moved.jumped; mapped.hitEnemy = moved.hitEnemy;
        result.characterStep = TapeCharacterStep(moved.status,moved.reason,characterSnapshot(r,moved.value),moved.jumped,moved.hitEnemy);
    }
    return result;
}
fun addFloor(recording: ref Recording,points: ref List[Vec2]) -> TapeFloorResult = {
    var entry = Entry(); entry.operation = 143i32; pack_List_Vec2_(&entry.args,points,recording.session);
    var result = dispatch(recording,&entry); var floor = TapeFloorResult(result.status,result.reason);
    if (result.status==game.OK) { floor.body = TapeBody(result.created.at(0i64),recording.session); floor.chain = TapeChain(result.created.at(1i64),recording.session); }
    return floor;
}
fun bindCharacter(recording: ref Recording,position: Vec2,settings: hero.CharacterSettings = hero.CharacterSettings()) -> TapeCharacterResult = {
    var entry = Entry(); entry.operation = 144i32; pack_Vec2(&entry.args,&position,recording.session);
    putWord(&entry.args,floatBits(settings.runSpeed)); putWord(&entry.args,floatBits(settings.jumpSpeed));
    putWord(&entry.args,floatBits(settings.gravity)); putWord(&entry.args,floatBits(settings.maxFallSpeed));
    var result = dispatch(recording,&entry); var bound = TapeCharacterResult(result.status,result.reason);
    if (result.status==game.OK) bound.number = TapeCharacter(result.created.at(0i64),recording.session); return bound;
}
fun watchEnemy(recording: ref Recording,character: TapeCharacter,enemy: TapeShape) -> TapeAction = {
    var entry = Entry(); entry.operation = 145i32; historical(&entry.args,character.serial,character.session,recording.session);
    historical(&entry.args,enemy.serial,enemy.session,recording.session); var result = dispatch(recording,&entry); return TapeAction(result.status,result.reason);
}
fun setCharacterInput(recording: ref Recording,character: TapeCharacter,input: hero.CharacterInput) -> TapeAction = {
    var entry = Entry(); entry.operation = 146i32; historical(&entry.args,character.serial,character.session,recording.session);
    putNumber(&entry.args,input.axis as i64); putNumber(&entry.args,if input.jump then 1i64 else 0i64);
    var result = dispatch(recording,&entry); return TapeAction(result.status,result.reason);
}
fun moveCharacterAfterStep(recording: ref Recording,character: TapeCharacter) -> TapeCharacterStep = {
    var entry = Entry(); entry.operation = 147i32; historical(&entry.args,character.serial,character.session,recording.session);
    var result = dispatch(recording,&entry); if (result.status!=game.OK) return TapeCharacterStep(result.status,result.reason); return result.characterStep;
}
fun readCharacter(recording: ref Recording,character: TapeCharacter) -> TapeCharacterRead = {
    if (recording.phase==0i32) return TapeCharacterRead(game.STALE);
    let status: i32 = mappingStatus(recording,Historical(character.serial,character.serial!=0i64 and character.session!=recording.session),5i32);
    if (status!=game.OK) return TapeCharacterRead(status);
    var value = hero.readCharacter(&recording.gameSession,&recording.map.at(character.serial-1i64).character);
    if (value.status!=game.OK) return TapeCharacterRead(value.status,value.reason);
    return TapeCharacterRead(value.status,value.reason,characterSnapshot(recording,value.value));
}
fun characterMessage(status: i32,reason: i32) -> str = { return hero.characterMessage(status,reason); }
fun captureCharacter(state: ref RecordedState,r: ref Recording,serial: i64,mapped: ref Mapping) -> () = {
    var value = hero.readCharacter(&r.gameSession,&mapped.character);
    observe(state,serial,"character.status",decimal(value.status as i64)); observe(state,serial,"character.reason",decimal(value.reason as i64));
    if (value.status!=game.OK) return;
    observe(state,serial,"character.runSpeed",word(floatBits(mapped.character.settings.runSpeed)));
    observe(state,serial,"character.jumpSpeed",word(floatBits(mapped.character.settings.jumpSpeed)));
    observe(state,serial,"character.gravity",word(floatBits(mapped.character.settings.gravity)));
    observe(state,serial,"character.maxFallSpeed",word(floatBits(mapped.character.settings.maxFallSpeed)));
    observe(state,serial,"character.input.axis",decimal(mapped.character.input.axis as i64));
    observe(state,serial,"character.input.jump",decimal(if mapped.character.input.jump then 1i64 else 0i64));
    observe(state,serial,"character.stepIndex",decimal(value.value.stepIndex));
    obs_Vec2(state,r,serial,"character.position",&value.value.position); obs_Vec2(state,r,serial,"character.velocity",&value.value.velocity);
    observe(state,serial,"character.grounded",decimal(if value.value.grounded then 1i64 else 0i64));
    observe(state,serial,"character.alive",decimal(if value.value.alive then 1i64 else 0i64));
    observe(state,serial,"character.jumpArmed",decimal(if value.value.jumpArmed then 1i64 else 0i64));
    observe(state,serial,"character.hasEnemy",decimal(if value.value.hasEnemy then 1i64 else 0i64));
    observe(state,serial,"character.enemy",decimal(shapeSerial(r,value.value.enemy)));
    obs_Vec2(state,r,serial,"character.capsule.center1",&value.value.capsule.center1); obs_Vec2(state,r,serial,"character.capsule.center2",&value.value.capsule.center2);
    observe(state,serial,"character.capsule.radius",word(floatBits(value.value.capsule.radius)));
    observe(state,serial,"character.jumped",decimal(if mapped.jumped then 1i64 else 0i64));
    observe(state,serial,"character.hitEnemy",decimal(if mapped.hitEnemy then 1i64 else 0i64));
}
