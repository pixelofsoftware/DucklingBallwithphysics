pack_raw_BodyDef(&entry.args,&def,recording.session);

var result = dispatch(recording,&entry);

var value = TapeBodyResult(result.status,result.reason); if (result.created.length()>0i64) value.number = TapeBody(result.created.at(0i64),recording.session); return value; }

fun createBodyWithShape(recording: ref Recording, def: raw.BodyDef,
    source: raw.ShapeRecord, invoke: bool, hasObjectId: bool, objectId: Key64) -> TapePairResult = { var entry = Entry(); entry.operation = 4i32;

pack_raw_BodyDef(&entry.args,&def,recording.session);

pack_raw_ShapeRecord(&entry.args,&source,recording.session);

putNumber(&entry.args,if invoke then 1i64 else 0i64);

putNumber(&entry.args,if hasObjectId then 1i64 else 0i64);

pack_Key64(&entry.args,&objectId,recording.session);

var result = dispatch(recording,&entry);

var value = TapePairResult(result.status,result.reason); if (result.created.length()==2i64) { value.body = TapeBody(result.created.at(0i64),recording.session); value.shape = TapeShape(result.created.at(1i64),recording.session); } return value; }

