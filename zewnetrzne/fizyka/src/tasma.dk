fun reservedObjects(e: ref Entry) -> i64 = {
if (e.operation==143i32) { var p = Reader(); p.values = copy e.args; let count: i64 = parseInteger(&p,0i64,p.values.length()); return count+1i64; }
if (e.operation==144i32) return 1i64;
if (e.operation==1i32) return 2i64;
if (e.operation==2i32) return 2i64;
if (e.operation==3i32) return 1i64;
if (e.operation==4i32) return 2i64;
if (e.operation==5i32) return 2i64;
if (e.operation==6i32) return 1i64;
if (e.operation==7i32) return 1i64;
if (e.operation==66i32) return 1i64;
if (e.operation==88i32) return 1i64;
if (e.operation==89i32) return 1i64;
if (e.operation==90i32) return 2i64;
if (e.operation==91i32) return 1i64;
if (e.operation==92i32) return 1i64;
if (e.operation==93i32) return 1i64;
if (e.operation==94i32) return 1i64;
if (e.operation==95i32) return 1i64;
return 0i64;
}
fun recordLine(e: ref Entry,sequence: i64) -> String = {
    var row = stringReserve(128i64);
    if (e.kind==2i32) { row.append("T "); row.append(decimal(e.tick)); row.append(' '); row.append(decimal(sequence)); }
    else { row.append(if e.kind==0i32 then "I " else "C "); if (e.kind==1i32) { row.append(decimal(e.tick)); row.append(' '); }
        row.append(decimal(sequence)); row.append(' '); row.append(operationName(e.operation)); row.append(' '); row.append(decimal(e.args.length()));
        var i: i64 = 0i64; while (i<e.args.length()) { row.append(' '); row.append(e.args.at(i)); i += 1i64; } }
    row.append(' '); row.append(decimal(e.status as i64)); row.append(' '); row.append(decimal(e.reason as i64));
    if (e.kind!=2i32) { row.append(' '); row.append(decimal(e.created.length())); var j: i64 = 0i64; while (j<e.created.length()) { row.append(' '); row.append(decimal(e.created.at(j))); j += 1i64; } }
    row.append('\n'); return row;
}
fun header(t: ref Tape) -> String = { var s = text("H R5 1 "); s.append(ENGINE64); s.append(' '); s.append(COMPILER40); s.append(' '); s.append(&t.application); s.append('\n'); return s; }
fun settingsLine(t: ref Tape) -> String = { var s = text("S "); s.append(decimal(t.settings.stepsPerSecond as i64)); s.append(' '); s.append(word(floatBits(1.0f32/(t.settings.stepsPerSecond as f32))));
    s.append(' '); s.append(decimal(t.settings.subStepCount as i64)); s.append(' '); s.append(decimal(t.settings.maxStepsPerFrame as i64));
    s.append(' '); s.append(word(floatBits(t.settings.pixelsPerMetre))); s.append(' '); s.append(word(floatBits(t.settings.screenOrigin.x))); s.append(' '); s.append(word(floatBits(t.settings.screenOrigin.y))); s.append('\n'); return s; }
fun serializedSize(t: ref Tape) -> i64 = { var h = header(t); var s = settingsLine(t); var size: i64 = h.length()+s.length()+23i64; var i: i64 = 0i64;
    while (i<t.records.length()) { var row = recordLine(t.records.at(i),i); size += row.length(); i += 1i64; } return size; }
fun dispatch(r: ref Recording,e: ref Entry) -> Execution = {
    if (r.phase==0i32) return Execution(game.STALE);
    if (r.rendering or (r.phase!=1i32 and r.phase!=2i32)) return Execution(MODE);
    var count: i64 = reservedObjects(e);
    # Chain segment count is known from the copied descriptor before mutation.


    if (e.operation==61i32) { var p = Reader(); p.values = copy e.args; readHistorical(&p); var d = game.ChainDescription(); read_game_ChainDescription(&p,&d);
        if (p.valid) count = 1i64+(if d.isLoop then d.points.length() else (if d.points.length()>3i64 then d.points.length()-3i64 else 0i64)); }


    e.kind = if r.phase==1i32 then 0i32 else 1i32; e.tick = r.gameSession.stepIndex;
    var row = recordLine(e,r.tape.records.length());
    if (r.tape.records.length()+3i64>r.tape.limits.maxRecords or count>r.tape.limits.maxObjects-r.map.length()
        or row.length()+r.serializedBytes+24i64+count*12i64>r.tape.limits.maxBytes) return Execution(TAPE_LIMIT);
    var result = execute(r,e,true); e.status = result.status; e.reason = result.reason;
    var actualRow = recordLine(e,r.tape.records.length()); r.serializedBytes += actualRow.length();
    r.tape.records.push(copy e); rememberContacts(r); return result;
}


fun addBall(recording: ref Recording, position: Vec2,
    radius: f32 = 0.5f32, options: start.ObjectSettings = start.ObjectSettings()) -> TapePairResult = { var entry = Entry(); entry.operation = 1i32;

pack_Vec2(&entry.args,&position,recording.session);

putWord(&entry.args,floatBits(radius));

pack_start_ObjectSettings(&entry.args,&options,recording.session);

var result = dispatch(recording,&entry);

var value = TapePairResult(result.status,result.reason); if (result.created.length()==2i64) { value.body = TapeBody(result.created.at(0i64),recording.session); value.shape = TapeShape(result.created.at(1i64),recording.session); } return value; }

fun addBox(recording: ref Recording, position: Vec2,
    halfSize: Vec2 = Vec2(0.5f32,0.5f32),
    options: start.ObjectSettings = start.ObjectSettings()) -> TapePairResult = { var entry = Entry(); entry.operation = 2i32;

pack_Vec2(&entry.args,&position,recording.session);

pack_Vec2(&entry.args,&halfSize,recording.session);

pack_start_ObjectSettings(&entry.args,&options,recording.session);

var result = dispatch(recording,&entry);

var value = TapePairResult(result.status,result.reason); if (result.created.length()==2i64) { value.body = TapeBody(result.created.at(0i64),recording.session); value.shape = TapeShape(result.created.at(1i64),recording.session); } return value; }

