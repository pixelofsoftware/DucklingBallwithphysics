fun execute(r: ref Recording,e: ref Entry,perform: bool) -> Execution = { var result = Execution(); var input = Reader(); input.values = copy e.args;

    if (e.operation==0i32) {

var openedSettings: start.GameSettings = r.tape.settings;
read_Vec2(&input,&openedSettings.physics.gravity);
openedSettings.physics.maximumLinearSpeed = fromBits(readWord(&input));
openedSettings.physics.contactHertz = fromBits(readWord(&input));
openedSettings.physics.contactDampingRatio = fromBits(readWord(&input));
openedSettings.physics.maxContactPushSpeed = fromBits(readWord(&input));
openedSettings.physics.restitutionThreshold = fromBits(readWord(&input));
openedSettings.physics.hitEventThreshold = fromBits(readWord(&input));
openedSettings.physics.enableWarmStarting = parseInteger(&input,0i64,1i64)==1i64;
openedSettings.enableSleeping = parseInteger(&input,0i64,1i64)==1i64;
openedSettings.enableContinuous = parseInteger(&input,0i64,1i64)==1i64;
openedSettings.physics.enableContinuous = openedSettings.enableContinuous;
if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT);
if (not perform) return result;
var opened = start.openGame(openedSettings); result.status = opened.status;
if (opened.status==game.OK) { r.gameSession = opened.session; r.tape.settings = openedSettings; }
return result;
}

    if (e.operation==1i32) {

var position: Vec2 = Vec2(); read_Vec2(&input,&position);

var radius: f32 = 0f32; radius = fromBits(readWord(&input));

var options: start.ObjectSettings = start.ObjectSettings(); read_start_ObjectSettings(&input,&options);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;



if (result.status!=game.OK) return result;

var called: game.PairResult = start.addBall(&r.gameSession,position,radius,options);

result.status = called.status;

if (result.status!=game.OK) return result;

var mb = Mapping(); mb.kind = 1i32; mb.body = called.body.number; addMapping(r,mb,e); var ms = Mapping(); ms.kind = 2i32; ms.shape = called.shape.number; addMapping(r,ms,e);

result.created = copy e.created; return result; }

    if (e.operation==2i32) {

var position: Vec2 = Vec2(); read_Vec2(&input,&position);

var halfSize: Vec2 = Vec2(); read_Vec2(&input,&halfSize);

var options: start.ObjectSettings = start.ObjectSettings(); read_start_ObjectSettings(&input,&options);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;



if (result.status!=game.OK) return result;

var called: game.PairResult = start.addBox(&r.gameSession,position,halfSize,options);

result.status = called.status;

if (result.status!=game.OK) return result;

var mb = Mapping(); mb.kind = 1i32; mb.body = called.body.number; addMapping(r,mb,e); var ms = Mapping(); ms.kind = 2i32; ms.shape = called.shape.number; addMapping(r,ms,e);

result.created = copy e.created; return result; }

    if (e.operation==3i32) {

var def: raw.BodyDef = raw.BodyDef(); read_raw_BodyDef(&input,&def);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;



if (result.status!=game.OK) return result;

var called: game.BodyResult = game.createCheckedBody(r.gameSession.world,def);

result.status = called.status;

if (result.status!=game.OK) return result;

var mapped = Mapping(); mapped.kind = 1i32; mapped.body = called.number; addMapping(r,mapped,e);

result.created = copy e.created; return result; }

    if (e.operation==4i32) {

var def: raw.BodyDef = raw.BodyDef(); read_raw_BodyDef(&input,&def);

var source: raw.ShapeRecord = raw.ShapeRecord(); read_raw_ShapeRecord(&input,&source);

var invoke: bool = false; invoke = parseInteger(&input,0i64,1i64)==1i64;

var hasObjectId: bool = false; hasObjectId = parseInteger(&input,0i64,1i64)==1i64;

var objectId: Key64 = Key64(); read_Key64(&input,&objectId);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;



if (result.status!=game.OK) return result;

var called: game.PairResult = game.createBodyWithShape(r.gameSession.world,def,source,invoke,hasObjectId,objectId);

result.status = called.status;

if (result.status!=game.OK) return result;

var mb = Mapping(); mb.kind = 1i32; mb.body = called.body.number; addMapping(r,mb,e); var ms = Mapping(); ms.kind = 2i32; ms.shape = called.shape.number; addMapping(r,ms,e);

result.created = copy e.created; return result; }

    if (e.operation==5i32) {

var def: raw.BodyDef = raw.BodyDef(); read_raw_BodyDef(&input,&def);

var geometry: game.BoxGeometry = game.BoxGeometry(); read_game_BoxGeometry(&input,&geometry);

var properties: raw.ShapeRecord = raw.ShapeRecord(); read_raw_ShapeRecord(&input,&properties);

var invoke: bool = false; invoke = parseInteger(&input,0i64,1i64)==1i64;

var hasObjectId: bool = false; hasObjectId = parseInteger(&input,0i64,1i64)==1i64;

var objectId: Key64 = Key64(); read_Key64(&input,&objectId);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;



if (result.status!=game.OK) return result;

var called: game.PairResult = game.createBodyWithBox(r.gameSession.world,def,geometry,properties,invoke,hasObjectId,objectId);

result.status = called.status;

if (result.status!=game.OK) return result;

var mb = Mapping(); mb.kind = 1i32; mb.body = called.body.number; addMapping(r,mb,e); var ms = Mapping(); ms.kind = 2i32; ms.shape = called.shape.number; addMapping(r,ms,e);

result.created = copy e.created; return result; }

    if (e.operation==6i32) {

let h_parent = readHistorical(&input); var parent = game.BodyNumber();

var source: raw.ShapeRecord = raw.ShapeRecord(); read_raw_ShapeRecord(&input,&source);

var invoke: bool = false; invoke = parseInteger(&input,0i64,1i64)==1i64;

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;

if (result.status==game.OK) result.status = mappingStatus(r,h_parent,1i32); if (result.status==game.OK) parent = r.map.at(h_parent.serial-1i64).body;

if (result.status!=game.OK) return result;

var called: game.ShapeResult = game.addShape(r.gameSession.world,parent,source,invoke);

result.status = called.status;

if (result.status!=game.OK) return result;

var mapped = Mapping(); mapped.kind = 2i32; mapped.shape = called.number; addMapping(r,mapped,e);

result.created = copy e.created; return result; }

    if (e.operation==7i32) {

let h_parent = readHistorical(&input); var parent = game.BodyNumber();

var geometry: game.BoxGeometry = game.BoxGeometry(); read_game_BoxGeometry(&input,&geometry);

var properties: raw.ShapeRecord = raw.ShapeRecord(); read_raw_ShapeRecord(&input,&properties);

var invoke: bool = false; invoke = parseInteger(&input,0i64,1i64)==1i64;

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;

if (result.status==game.OK) result.status = mappingStatus(r,h_parent,1i32); if (result.status==game.OK) parent = r.map.at(h_parent.serial-1i64).body;

if (result.status!=game.OK) return result;

var called: game.ShapeResult = game.addBox(r.gameSession.world,parent,geometry,properties,invoke);

result.status = called.status;

if (result.status!=game.OK) return result;

var mapped = Mapping(); mapped.kind = 2i32; mapped.shape = called.number; addMapping(r,mapped,e);

result.created = copy e.created; return result; }

    if (e.operation==8i32) {

let h_number = readHistorical(&input); var number = game.BodyNumber();

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;

if (result.status==game.OK) result.status = mappingStatus(r,h_number,1i32); if (result.status==game.OK) number = r.map.at(h_number.serial-1i64).body;

if (result.status!=game.OK) return result;

var called: i32 = game.destroyBody(r.gameSession.world,number);

result.status = called;

if (result.status!=game.OK) return result;

result.created = copy e.created; return result; }

    if (e.operation==9i32) {

let h_number = readHistorical(&input); var number = game.ShapeNumber();

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;

if (result.status==game.OK) result.status = mappingStatus(r,h_number,2i32); if (result.status==game.OK) number = r.map.at(h_number.serial-1i64).shape;

if (result.status!=game.OK) return result;

var called: i32 = game.destroyShape(r.gameSession.world,number);

result.status = called;

if (result.status!=game.OK) return result;

result.created = copy e.created; return result; }

    if (e.operation==10i32) {

let h_number = readHistorical(&input); var number = game.BodyNumber();

var position: Vec2 = Vec2(); read_Vec2(&input,&position);

var rotation: Rot = Rot(); read_Rot(&input,&rotation);

if (not input.valid or input.index!=input.values.length()) return Execution(FORMAT); if (not perform) return result;

if (result.status==game.OK) result.status = mappingStatus(r,h_number,1i32); if (result.status==game.OK) number = r.map.at(h_number.serial-1i64).body;

if (result.status!=game.OK) return result;

var called: i32 = game.setTransform(r.gameSession.world,number,position,rotation);

result.status = called;

if (result.status!=game.OK) return result;

result.created = copy e.created; return result; }

