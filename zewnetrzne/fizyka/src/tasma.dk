fun obs_game_PrismaticDescription(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.PrismaticDescription) -> () = { obs_Vec2(s,r,serial,observationPath(field,"localAnchorA").asSlice(),&v.localAnchorA); obs_Vec2(s,r,serial,observationPath(field,"localAnchorB").asSlice(),&v.localAnchorB); obs_Vec2(s,r,serial,observationPath(field,"localAxisA").asSlice(),&v.localAxisA); observe(s,serial,observationPath(field,"referenceAngle").asSlice(),word(floatBits(v.referenceAngle))); observe(s,serial,observationPath(field,"targetTranslation").asSlice(),word(floatBits(v.targetTranslation))); observe(s,serial,observationPath(field,"hertz").asSlice(),word(floatBits(v.hertz))); observe(s,serial,observationPath(field,"dampingRatio").asSlice(),word(floatBits(v.dampingRatio))); observe(s,serial,observationPath(field,"lowerTranslation").asSlice(),word(floatBits(v.lowerTranslation))); observe(s,serial,observationPath(field,"upperTranslation").asSlice(),word(floatBits(v.upperTranslation))); observe(s,serial,observationPath(field,"maxMotorForce").asSlice(),word(floatBits(v.maxMotorForce))); observe(s,serial,observationPath(field,"motorSpeed").asSlice(),word(floatBits(v.motorSpeed))); observe(s,serial,observationPath(field,"enableSpring").asSlice(),decimal(if v.enableSpring then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enableLimit").asSlice(),decimal(if v.enableLimit then 1i64 else 0i64)); observe(s,serial,observationPath(field,"enableMotor").asSlice(),decimal(if v.enableMotor then 1i64 else 0i64)); observe(s,serial,observationPath(field,"collideConnected").asSlice(),decimal(if v.collideConnected then 1i64 else 0i64)); observe(s,serial,observationPath(field,"hasObjectId").asSlice(),decimal(if v.hasObjectId then 1i64 else 0i64)); obs_Key64(s,r,serial,observationPath(field,"objectId").asSlice(),&v.objectId); }

fun obs_game_JointView(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.JointView) -> () = { if (v.jointType==2i32) { obs_game_MotorDescription(s,r,serial,observationPath(field,"motorParameters").asSlice(),&v.motorParameters); } if (v.jointType==6i32) { obs_game_WeldDescription(s,r,serial,observationPath(field,"weldParameters").asSlice(),&v.weldParameters); } if (v.jointType==1i32) { obs_game_FilterDescription(s,r,serial,observationPath(field,"filterParameters").asSlice(),&v.filterParameters); } if (v.jointType==7i32) { obs_game_WheelDescription(s,r,serial,observationPath(field,"wheelParameters").asSlice(),&v.wheelParameters); } if (v.jointType==3i32) { obs_game_MouseDescription(s,r,serial,observationPath(field,"mouseParameters").asSlice(),&v.mouseParameters); } observe(s,serial,observationPath(field,"number").asSlice(),decimal(jointSerial(r,v.number))); observe(s,serial,observationPath(field,"bodyA").asSlice(),decimal(bodySerial(r,v.bodyA))); observe(s,serial,observationPath(field,"bodyB").asSlice(),decimal(bodySerial(r,v.bodyB))); observe(s,serial,observationPath(field,"jointType").asSlice(),decimal(v.jointType as i64)); obs_Vec2(s,r,serial,observationPath(field,"localAnchorA").asSlice(),&v.localAnchorA); obs_Vec2(s,r,serial,observationPath(field,"localAnchorB").asSlice(),&v.localAnchorB); observe(s,serial,observationPath(field,"collideConnected").asSlice(),decimal(if v.collideConnected then 1i64 else 0i64)); observe(s,serial,observationPath(field,"hasObjectId").asSlice(),decimal(if v.hasObjectId then 1i64 else 0i64)); obs_Key64(s,r,serial,observationPath(field,"objectId").asSlice(),&v.objectId); observe(s,serial,observationPath(field,"constraintHertz").asSlice(),word(floatBits(v.constraintHertz))); observe(s,serial,observationPath(field,"constraintDampingRatio").asSlice(),word(floatBits(v.constraintDampingRatio))); if (v.jointType==0i32) { obs_game_DistanceDescription(s,r,serial,observationPath(field,"distanceParameters").asSlice(),&v.distanceParameters); } if (v.jointType==5i32) { obs_game_RevoluteDescription(s,r,serial,observationPath(field,"revoluteParameters").asSlice(),&v.revoluteParameters); } if (v.jointType==4i32) { obs_game_PrismaticDescription(s,r,serial,observationPath(field,"prismaticParameters").asSlice(),&v.prismaticParameters); } observe(s,serial,observationPath(field,"referenceAngle").asSlice(),word(floatBits(v.referenceAngle))); obs_Vec2(s,r,serial,observationPath(field,"localAxisA").asSlice(),&v.localAxisA); observe(s,serial,observationPath(field,"angle").asSlice(),word(floatBits(v.angle))); observe(s,serial,observationPath(field,"translation").asSlice(),word(floatBits(v.translation))); observe(s,serial,observationPath(field,"speed").asSlice(),word(floatBits(v.speed))); observe(s,serial,observationPath(field,"motorTorque").asSlice(),word(floatBits(v.motorTorque))); obs_Vec2(s,r,serial,observationPath(field,"force").asSlice(),&v.force); observe(s,serial,observationPath(field,"torque").asSlice(),word(floatBits(v.torque))); observe(s,serial,observationPath(field,"linearSeparation").asSlice(),word(floatBits(v.linearSeparation))); observe(s,serial,observationPath(field,"angularSeparation").asSlice(),word(floatBits(v.angularSeparation))); observe(s,serial,observationPath(field,"currentLength").asSlice(),word(floatBits(v.currentLength))); observe(s,serial,observationPath(field,"motorForce").asSlice(),word(floatBits(v.motorForce))); }

fun obs_game_ShapeList(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.ShapeList) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); obs_List_game_ShapeNumber_(s,r,serial,observationPath(field,"values").asSlice(),&v.values); }

fun obs_List_game_JointNumber_(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref List[game.JointNumber]) -> () = { observe(s,serial,field,decimal(v.length())); var i: i64 = 0i64; while (i<v.length()) { var item: game.JointNumber = copy v.at(i); observe(s,serial,observationIndex(field,i).asSlice(),decimal(jointSerial(r,item))); i += 1i64; } }

fun obs_game_JointList(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref game.JointList) -> () = { observe(s,serial,observationPath(field,"status").asSlice(),decimal(v.status as i64)); observe(s,serial,observationPath(field,"reason").asSlice(),decimal(v.reason as i64)); obs_List_game_JointNumber_(s,r,serial,observationPath(field,"values").asSlice(),&v.values); }

fun obs_ManifoldPoint(s: ref RecordedState,r: ref Recording,serial: i64,field: str,v: ref ManifoldPoint) -> () = { obs_Vec2(s,r,serial,observationPath(field,"point").asSlice(),&v.point); obs_Vec2(s,r,serial,observationPath(field,"anchorA").asSlice(),&v.anchorA); obs_Vec2(s,r,serial,observationPath(field,"anchorB").asSlice(),&v.anchorB); observe(s,serial,observationPath(field,"separation").asSlice(),word(floatBits(v.separation))); observe(s,serial,observationPath(field,"normalImpulse").asSlice(),word(floatBits(v.normalImpulse))); observe(s,serial,observationPath(field,"tangentImpulse").asSlice(),word(floatBits(v.tangentImpulse))); observe(s,serial,observationPath(field,"totalNormalImpulse").asSlice(),word(floatBits(v.totalNormalImpulse))); observe(s,serial,observationPath(field,"normalVelocity").asSlice(),word(floatBits(v.normalVelocity))); observe(s,serial,observationPath(field,"id").asSlice(),decimal(v.id as i64)); observe(s,serial,observationPath(field,"persisted").asSlice(),decimal(if v.persisted then 1i64 else 0i64)); }

