import fizyka.kola.*;
import std.math;
import fizyka.ruch as motion;
import fizyka.swiat.b2MakePolygon as initializePolygon;
import fizyka.swiat.b2ValidateHull as validatePolygonHull;
import fizyka.rdzen as geometryChecks;
import fizyka.gra.finite as finiteGeometry;

class Hull { count: i32 = 0i32; points: Vec2[8] = zeroPolygonVectors(); }
# geometry.c:22-220. Reuse the existing centroid/normal kernel.
fun b2MakeSquare(halfWidth: f32) -> Polygon = { return b2MakeBox(halfWidth,halfWidth); }
fun b2MakeBox(hx: f32,hy: f32) -> Polygon = {
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(finiteGeometry(hx) and hx>0.0f32,"b2IsValidFloat( halfWidth ) && halfWidth > 0.0f\0","wielokaty.dk\0",40i32);
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(finiteGeometry(hy) and hy>0.0f32,"b2IsValidFloat( halfHeight ) && halfHeight > 0.0f\0","wielokaty.dk\0",41i32);
    var p = Polygon();p.count = 4i32;
    p.vertices[0] = Vec2(-hx,-hy);p.vertices[1] = Vec2(hx,-hy);
    p.vertices[2] = Vec2(hx,hy);p.vertices[3] = Vec2(-hx,hy);
    p.normals[0] = Vec2(0.0f32,-1.0f32);p.normals[1] = Vec2(1.0f32,0.0f32);
    p.normals[2] = Vec2(0.0f32,1.0f32);p.normals[3] = Vec2(-1.0f32,0.0f32);return p;
}
fun b2MakeRoundedBox(hx: f32,hy: f32,radius: f32) -> Polygon = { if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(finiteGeometry(radius) and radius>=0.0f32,"b2IsValidFloat( radius ) && radius >= 0.0f\0","wielokaty.dk\0",48i32); var p = b2MakeBox(hx,hy);p.radius = radius;return p; }
fun b2MakePolygon(h: ref Hull,radius: f32) -> Polygon = {
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(b2ValidateHull(h),"b2ValidateHull( hull )\0","wielokaty.dk\0",50i32);
    if (h.count<3i32) return b2MakeSquare(0.5f32);
    var p = Polygon();p.count = h.count;p.radius = radius;var i: i32 = 0i32;
    while (i<p.count) { p.vertices[i] = h.points[i];i += 1i32; }initializePolygon(&p);return p;
}
fun b2MakeOffsetPolygon(h: ref Hull,position: Vec2,rotation: Rot) -> Polygon = { return b2MakeOffsetRoundedPolygon(h,position,rotation,0.0f32); }
fun b2MakeOffsetRoundedPolygon(h: ref Hull,position: Vec2,rotation: Rot,radius: f32) -> Polygon = {
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(b2ValidateHull(h),"b2ValidateHull( hull )\0","wielokaty.dk\0",57i32);
    if (h.count<3i32) return b2MakeSquare(0.5f32);
    var p = Polygon();p.count = h.count;p.radius = radius;let xf: Transform = Transform(position,rotation);var i: i32 = 0i32;
    while (i<p.count) { p.vertices[i] = b2TransformPoint(xf,h.points[i]);i += 1i32; }initializePolygon(&p);return p;
}
fun b2TransformPolygon(xf: Transform,source: ref Polygon) -> Polygon = {
    var p: Polygon = source;var i: i32 = 0i32;
    while (i<p.count) { p.vertices[i] = b2TransformPoint(xf,p.vertices[i]);p.normals[i] = b2RotateVector(xf.q,p.normals[i]);i += 1i32; }
    p.centroid = b2TransformPoint(xf,p.centroid);return p;
}
# hull.c:13-84. Fixed arrays own the recursion input and output.
fun recurseHull(p1: Vec2,p2: Vec2,ps: ref Vec2[8],count: i32) -> Hull = {
    var h = Hull();if (count == 0i32) return h;
    let e: Vec2 = motion.b2Normalize(b2Sub(p2,p1));var right: Vec2[8];var n: i32 = 0i32;var best: i32 = 0i32;
    var distance: f32 = motion.b2Cross(b2Sub(ps[0],p1),e);
    if (distance>0.0f32) { right[n] = ps[0];n += 1i32; }
    var i: i32 = 1i32;while (i<count) {
        let d: f32 = motion.b2Cross(b2Sub(ps[i],p1),e);if (d>distance) { best = i;distance = d; }
        if (d>0.0f32) { right[n] = ps[i];n += 1i32; }i += 1i32;
    }
    if (distance<2.0f32*B2_LINEAR_SLOP) return h;
    let point: Vec2 = ps[best];let a: Hull = recurseHull(p1,point,&right,n);let b: Hull = recurseHull(point,p2,&right,n);
    i = 0i32;while (i<a.count) { h.points[h.count] = a.points[i];h.count += 1i32;i += 1i32; }
    h.points[h.count] = point;h.count += 1i32;i = 0i32;
    while (i<b.count) { h.points[h.count] = b.points[i];h.count += 1i32;i += 1i32; }
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(h.count<8i32,"hull.count < B2_MAX_POLYGON_VERTICES\0","wielokaty.dk\0",82i32);return h;
}
# hull.c:90-284, welding correction #1118 (poprawki.patch): compare with accepted ps, not original points.
template(N: i64)
fun b2ComputeHullArray(points: ref Vec2[N],count: i32) -> Hull = {
    var h = Hull();if (count<3i32 or count>8i32) return h;
    var lower = Vec2(FLT_MAX,FLT_MAX);var upper = Vec2(-FLT_MAX,-FLT_MAX);var ps: Vec2[8];var n: i32 = 0i32;
    let slop: f32 = B2_LINEAR_SLOP;let tol: f32 = 16.0f32*slop*slop;var i: i32 = 0i32;
    while (i<count) {
        lower = Vec2(b2MinFloat(lower.x,points[i].x),b2MinFloat(lower.y,points[i].y));upper = Vec2(if upper.x > points[i].x then upper.x else points[i].x,if upper.y > points[i].y then upper.y else points[i].y);
        var unique: bool = true;var j: i32 = 0i32;while (j<n and unique) { if (motion.b2LengthSquared(b2Sub(points[i],ps[j]))<tol) unique = false;j += 1i32; }
        if (unique) { ps[n] = points[i];n += 1i32; }i += 1i32;
    }
    if (n<3i32) return h;
    let center: Vec2 = motion.b2MulSV(0.5f32,b2Add(lower,upper));var f1: i32 = 0i32;var d1: f32 = motion.b2LengthSquared(b2Sub(ps[0],center));i = 1i32;
    while (i<n) { let d: f32 = motion.b2LengthSquared(b2Sub(ps[i],center));if (d>d1) { f1 = i;d1 = d; }i += 1i32; }
    let p1: Vec2 = ps[f1];ps[f1] = ps[n-1i32];n -= 1i32;
    var f2: i32 = 0i32;var d2: f32 = motion.b2LengthSquared(b2Sub(ps[0],p1));i = 1i32;
    while (i<n) { let d: f32 = motion.b2LengthSquared(b2Sub(ps[i],p1));if (d>d2) { f2 = i;d2 = d; }i += 1i32; }
    let p2: Vec2 = ps[f2];ps[f2] = ps[n-1i32];n -= 1i32;
    var right: Vec2[8];var left: Vec2[8];var nr: i32 = 0i32;var nl: i32 = 0i32;let e: Vec2 = motion.b2Normalize(b2Sub(p2,p1));i = 0i32;
    while (i<n) { let d: f32 = motion.b2Cross(b2Sub(ps[i],p1),e);
        if (d>=2.0f32*slop) { right[nr] = ps[i];nr += 1i32; }else if (d<= -2.0f32*slop) { left[nl] = ps[i];nl += 1i32; }i += 1i32;
    }
    let a: Hull = recurseHull(p1,p2,&right,nr);let b: Hull = recurseHull(p2,p1,&left,nl);if (a.count == 0i32 and b.count == 0i32) return h;
    h.points[0] = p1;h.count = 1i32;i = 0i32;while (i<a.count) { h.points[h.count] = a.points[i];h.count += 1i32;i += 1i32; }
    h.points[h.count] = p2;h.count += 1i32;i = 0i32;while (i<b.count) { h.points[h.count] = b.points[i];h.count += 1i32;i += 1i32; }
    if (geometryChecks.B2_ENABLE_ASSERT) geometryChecks.b2Assert(h.count<=8i32,"hull.count <= B2_MAX_POLYGON_VERTICES\0","wielokaty.dk\0",109i32);
    var searching: bool = true;while (searching and h.count>2i32) {
        searching = false;i = 0i32;var removed: bool = false;while (i<h.count and not removed) {
            let i2: i32 = (i+1i32)%h.count;let i3: i32 = (i+2i32)%h.count;let r: Vec2 = motion.b2Normalize(b2Sub(h.points[i3],h.points[i]));
            if (motion.b2Cross(b2Sub(h.points[i2],h.points[i]),r)<=2.0f32*slop) {
                var j: i32 = i2;while (j<h.count-1i32) { h.points[j] = h.points[j+1i32];j += 1i32; }h.count -= 1i32;searching = true;removed = true;
            }i += 1i32;
        }
    }
    if (h.count<3i32) h.count = 0i32;return h;
}

# Storage initializer for Box2D 8c661469, include/box2d/collision.h:136,139.
# A typed declaration initializes the array and supplies Polygon()'s field default.
# Duckling 2321f92c: default_constructors.cpp:175-205,234-250.
fun zeroPolygonVectors() -> Vec2[8] = {
    var values: Vec2[8];
    return values;
}

# Box2D 8c661469, include/box2d/collision.h:133.
# Fixed arrays are values; no pointers, allocation, or C ABI layout is assumed.
# Vec2's explicit +0 defaults initialize all eight slots in each array.
class Polygon {
    vertices: Vec2[8] = zeroPolygonVectors();
    normals: Vec2[8] = zeroPolygonVectors();
    centroid: Vec2 = Vec2();
    radius: f32 = 0.0f32;
    count: i32 = 0i32;
}

# Box2D 8c661469, include/box2d/collision.h:322
class SegmentDistanceResult {
    closest1: Vec2 = Vec2();
    closest2: Vec2 = Vec2();
    fraction1: f32 = 0.0f32;
    fraction2: f32 = 0.0f32;
    distanceSquared: f32 = 0.0f32;
}

# Box2D 8c661469, src/manifold.c:689 (C FLT_MAX).
const FLT_MAX: f32 = 3.4028234663852886e38f32;

# Box2D 8c661469, include/box2d/math_functions.h:126
fun b2MinFloat(a: f32, b: f32) -> f32 = {
    if (a < b) return a;
    return b;
}

# Box2D 8c661469, include/box2d/math_functions.h:144
fun b2ClampFloat(a: f32, lower: f32, upper: f32) -> f32 = {
    if (a < lower) return lower;
    if (a > upper) return upper;
    return a;
}

# Box2D 8c661469, include/box2d/math_functions.h:160
fun b2Dot(a: Vec2, b: Vec2) -> f32 = {
    return a.x * b.x + a.y * b.y;
}

# Box2D 8c661469, include/box2d/math_functions.h:178
fun b2CrossSV(s: f32, v: Vec2) -> Vec2 = {
    return Vec2(-s * v.y, s * v.x);
}

# Box2D 8c661469, include/box2d/math_functions.h:208
fun b2Neg(a: Vec2) -> Vec2 = {
    return Vec2(-a.x, -a.y);
}

# Box2D 8c661469, include/box2d/math_functions.h:363
fun b2DistanceSquared(a: Vec2, b: Vec2) -> f32 = {
    let c: Vec2 = Vec2(b.x - a.x, b.y - a.y);
    return c.x * c.x + c.y * c.y;
}

# Box2D 8c661469, src/manifold.c:14 (macro)
fun B2_MAKE_ID(a: i32, b: i32) -> u16 = {
    return ((((a as u8) as u32) << 8u32) | ((b as u8) as u32)) as u16;
}

# Box2D 8c661469, src/distance.c:33
fun b2SegmentDistance(p1: Vec2, q1: Vec2, p2: Vec2, q2: Vec2) -> SegmentDistanceResult = {
    var result = SegmentDistanceResult();
    let d1: Vec2 = b2Sub(q1, p1);
    let d2: Vec2 = b2Sub(q2, p2);
    let r: Vec2 = b2Sub(p1, p2);
    let dd1: f32 = b2Dot(d1, d1);
    let dd2: f32 = b2Dot(d2, d2);
    let rd1: f32 = b2Dot(r, d1);
    let rd2: f32 = b2Dot(r, d2);
    let epsSqr: f32 = FLT_EPSILON * FLT_EPSILON;

    if (dd1 < epsSqr or dd2 < epsSqr) {
        if (dd1 >= epsSqr) {
            result.fraction1 = b2ClampFloat(-rd1 / dd1, 0.0f32, 1.0f32);
            result.fraction2 = 0.0f32;
        } else if (dd2 >= epsSqr) {
            result.fraction1 = 0.0f32;
            result.fraction2 = b2ClampFloat(rd2 / dd2, 0.0f32, 1.0f32);
        } else {
            result.fraction1 = 0.0f32;
            result.fraction2 = 0.0f32;
        }
    } else {
        let d12: f32 = b2Dot(d1, d2);
        let denominator: f32 = dd1 * dd2 - d12 * d12;
        var f1: f32 = 0.0f32;
        if (not (denominator == 0.0f32)) {
            f1 = b2ClampFloat((d12 * rd2 - rd1 * dd2) / denominator, 0.0f32, 1.0f32);
        }
        var f2: f32 = (d12 * f1 + rd2) / dd2;
        if (f2 < 0.0f32) {
            f2 = 0.0f32;
            f1 = b2ClampFloat(-rd1 / dd1, 0.0f32, 1.0f32);
        } else if (f2 > 1.0f32) {
            f2 = 1.0f32;
            f1 = b2ClampFloat((d12 - rd1) / dd1, 0.0f32, 1.0f32);
        }
        result.fraction1 = f1;
        result.fraction2 = f2;
    }
    result.closest1 = b2MulAdd(p1, result.fraction1, d1);
    result.closest2 = b2MulAdd(p2, result.fraction2, d2);
    result.distanceSquared = b2DistanceSquared(result.closest1, result.closest2);
    return result;
}

# Box2D 8c661469, src/manifold.c:545
fun b2ClipPolygons(polyA: ref Polygon, polyB: ref Polygon, edgeA: i32, edgeB: i32, flip: bool) -> Manifold = {
    var manifold = Manifold();
    # Value copies replace C's two selected const pointers, without changing inputs.
    var poly1 = Polygon();
    var poly2 = Polygon();
    var i11: i32 = 0i32;
    var i12: i32 = 0i32;
    var i21: i32 = 0i32;
    var i22: i32 = 0i32;
    if (flip) {
        poly1 = polyB;
        poly2 = polyA;
        i11 = edgeB;
        i12 = if edgeB + 1i32 < polyB.count then edgeB + 1i32 else 0i32;
        i21 = edgeA;
        i22 = if edgeA + 1i32 < polyA.count then edgeA + 1i32 else 0i32;
    } else {
        poly1 = polyA;
        poly2 = polyB;
        i11 = edgeA;
        i12 = if edgeA + 1i32 < polyA.count then edgeA + 1i32 else 0i32;
        i21 = edgeB;
        i22 = if edgeB + 1i32 < polyB.count then edgeB + 1i32 else 0i32;
    }
    let normal: Vec2 = poly1.normals[i11];
    let v11: Vec2 = poly1.vertices[i11];
    let v12: Vec2 = poly1.vertices[i12];
    let v21: Vec2 = poly2.vertices[i21];
    let v22: Vec2 = poly2.vertices[i22];
    let tangent: Vec2 = b2CrossSV(1.0f32, normal);
    let lower1: f32 = 0.0f32;
    let upper1: f32 = b2Dot(b2Sub(v12, v11), tangent);
    let upper2: f32 = b2Dot(b2Sub(v21, v11), tangent);
    let lower2: f32 = b2Dot(b2Sub(v22, v11), tangent);
    if (upper2 < lower1 or upper1 < lower2) return manifold;

    var vLower = Vec2();
    if (lower2 < lower1 and upper2 - lower2 > FLT_EPSILON) {
        vLower = b2Lerp(v22, v21, (lower1 - lower2) / (upper2 - lower2));
    } else {
        vLower = v22;
    }
    var vUpper = Vec2();
    if (upper2 > upper1 and upper2 - lower2 > FLT_EPSILON) {
        vUpper = b2Lerp(v22, v21, (upper1 - lower2) / (upper2 - lower2));
    } else {
        vUpper = v21;
    }
    let separationLower: f32 = b2Dot(b2Sub(vLower, v11), normal);
    let separationUpper: f32 = b2Dot(b2Sub(vUpper, v11), normal);
    let r1: f32 = poly1.radius;
    let r2: f32 = poly2.radius;
    vLower = b2MulAdd(vLower, 0.5f32 * (r1 - r2 - separationLower), normal);
    vUpper = b2MulAdd(vUpper, 0.5f32 * (r1 - r2 - separationUpper), normal);
    let radius: f32 = r1 + r2;
    if (flip == false) {
        manifold.normal = normal;
        manifold.point0.anchorA = vLower;
        manifold.point0.separation = separationLower - radius;
        manifold.point0.id = B2_MAKE_ID(i11, i22);
        manifold.pointCount = manifold.pointCount + 1i32;
        manifold.point1.anchorA = vUpper;
        manifold.point1.separation = separationUpper - radius;
        manifold.point1.id = B2_MAKE_ID(i12, i21);
        manifold.pointCount = manifold.pointCount + 1i32;
    } else {
        manifold.normal = b2Neg(normal);
        manifold.point0.anchorA = vUpper;
        manifold.point0.separation = separationUpper - radius;
        manifold.point0.id = B2_MAKE_ID(i21, i12);
        manifold.pointCount = manifold.pointCount + 1i32;
        manifold.point1.anchorA = vLower;
        manifold.point1.separation = separationLower - radius;
        manifold.point1.id = B2_MAKE_ID(i22, i11);
        manifold.pointCount = manifold.pointCount + 1i32;
    }
    return manifold;
}

# Box2D 8c661469, src/manifold.c:680
fun b2FindMaxSeparation(edgeIndex: ref i32, poly1: ref Polygon, poly2: ref Polygon) -> f32 = {
    let count1: i32 = poly1.count;
    let count2: i32 = poly2.count;
    var bestIndex: i32 = 0i32;
    var maxSeparation: f32 = -FLT_MAX;
    var i: i32 = 0i32;
    while (i < count1) {
        let n: Vec2 = poly1.normals[i];
        let v1: Vec2 = poly1.vertices[i];
        var si: f32 = FLT_MAX;
        var j: i32 = 0i32;
        while (j < count2) {
            let sij: f32 = b2Dot(n, b2Sub(poly2.vertices[j], v1));
            if (sij < si) si = sij;
            j = j + 1i32;
        }
        if (si > maxSeparation) {
            maxSeparation = si;
            bestIndex = i;
        }
        i = i + 1i32;
    }
    edgeIndex = bestIndex;
    return maxSeparation;
}

# Box2D 8c661469, src/manifold.c:736; active #if 1 branch (:834-938).
fun b2CollidePolygons(polygonA: ref Polygon, xfA: Transform, polygonB: ref Polygon, xfB: Transform) -> Manifold = {
    let origin: Vec2 = polygonA.vertices[0];
    let linearSlop: f32 = B2_LINEAR_SLOP;
    let speculativeDistance: f32 = B2_SPECULATIVE_DISTANCE;
    let sfA: Transform = Transform(b2Add(xfA.p, b2RotateVector(xfA.q, origin)), xfA.q);
    let xf: Transform = b2InvMulTransforms(sfA, xfB);
    var localPolyA = Polygon();
    localPolyA.count = polygonA.count;
    localPolyA.radius = polygonA.radius;
    localPolyA.vertices[0] = Vec2();
    localPolyA.normals[0] = polygonA.normals[0];
    var indexA: i32 = 1i32;
    while (indexA < localPolyA.count) {
        localPolyA.vertices[indexA] = b2Sub(polygonA.vertices[indexA], origin);
        localPolyA.normals[indexA] = polygonA.normals[indexA];
        indexA = indexA + 1i32;
    }
    var localPolyB = Polygon();
    localPolyB.count = polygonB.count;
    localPolyB.radius = polygonB.radius;
    var indexB: i32 = 0i32;
    while (indexB < localPolyB.count) {
        localPolyB.vertices[indexB] = b2TransformPoint(xf, polygonB.vertices[indexB]);
        localPolyB.normals[indexB] = b2RotateVector(xf.q, polygonB.normals[indexB]);
        indexB = indexB + 1i32;
    }
    var edgeA: i32 = 0i32;
    let separationA: f32 = b2FindMaxSeparation(&edgeA, &localPolyA, &localPolyB);
    var edgeB: i32 = 0i32;
    let separationB: f32 = b2FindMaxSeparation(&edgeB, &localPolyB, &localPolyA);
    let radius: f32 = localPolyA.radius + localPolyB.radius;
    if (separationA > speculativeDistance + radius or separationB > speculativeDistance + radius) {
        return Manifold();
    }

    var flip: bool = false;
    if (separationA >= separationB) {
        flip = false;
        let searchDirectionA: Vec2 = localPolyA.normals[edgeA];
        let countB: i32 = localPolyB.count;
        edgeB = 0i32;
        var minDotB: f32 = FLT_MAX;
        var incidentB: i32 = 0i32;
        while (incidentB < countB) {
            let dotB: f32 = b2Dot(searchDirectionA, localPolyB.normals[incidentB]);
            if (dotB < minDotB) {
                minDotB = dotB;
                edgeB = incidentB;
            }
            incidentB = incidentB + 1i32;
        }
    } else {
        flip = true;
        let searchDirectionB: Vec2 = localPolyB.normals[edgeB];
        let countA: i32 = localPolyA.count;
        edgeA = 0i32;
        var minDotA: f32 = FLT_MAX;
        var incidentA: i32 = 0i32;
        while (incidentA < countA) {
            let dotA: f32 = b2Dot(searchDirectionB, localPolyA.normals[incidentA]);
            if (dotA < minDotA) {
                minDotA = dotA;
                edgeA = incidentA;
            }
            incidentA = incidentA + 1i32;
        }
    }

    var manifold = Manifold();
    if (separationA > 0.1f32 * linearSlop or separationB > 0.1f32 * linearSlop) {
        let i11: i32 = edgeA;
        let i12: i32 = if edgeA + 1i32 < localPolyA.count then edgeA + 1i32 else 0i32;
        let i21: i32 = edgeB;
        let i22: i32 = if edgeB + 1i32 < localPolyB.count then edgeB + 1i32 else 0i32;
        let v11: Vec2 = localPolyA.vertices[i11];
        let v12: Vec2 = localPolyA.vertices[i12];
        let v21: Vec2 = localPolyB.vertices[i21];
        let v22: Vec2 = localPolyB.vertices[i22];
        let result: SegmentDistanceResult = b2SegmentDistance(v11, v12, v21, v22);
        # C B2_ASSERT is disabled in the contracted Release build.
        let distance: f32 = math.sqrt(result.distanceSquared);
        let separation: f32 = distance - radius;
        if (distance - radius > speculativeDistance) return manifold;
        manifold = b2ClipPolygons(&localPolyA, &localPolyB, edgeA, edgeB, flip);
        var minSeparation: f32 = FLT_MAX;
        var minIndex: i32 = 0i32;
        while (minIndex < manifold.pointCount) {
            let pointSeparation: f32 = if minIndex == 0i32 then manifold.point0.separation else manifold.point1.separation;
            minSeparation = b2MinFloat(minSeparation, pointSeparation);
            minIndex = minIndex + 1i32;
        }
        if (separation + 0.1f32 * linearSlop < minSeparation) {
            if (result.fraction1 == 0.0f32 and result.fraction2 == 0.0f32) {
                var normal00: Vec2 = b2Sub(v21, v11);
                let invDistance00: f32 = 1.0f32 / distance;
                normal00.x = normal00.x * invDistance00;
                normal00.y = normal00.y * invDistance00;
                let c100: Vec2 = b2MulAdd(v11, localPolyA.radius, normal00);
                let c200: Vec2 = b2MulAdd(v21, -localPolyB.radius, normal00);
                manifold.normal = normal00;
                manifold.point0.anchorA = b2Lerp(c100, c200, 0.5f32);
                manifold.point0.separation = distance - radius;
                manifold.point0.id = B2_MAKE_ID(i11, i21);
                manifold.pointCount = 1i32;
            } else if (result.fraction1 == 0.0f32 and result.fraction2 == 1.0f32) {
                var normal01: Vec2 = b2Sub(v22, v11);
                let invDistance01: f32 = 1.0f32 / distance;
                normal01.x = normal01.x * invDistance01;
                normal01.y = normal01.y * invDistance01;
                let c101: Vec2 = b2MulAdd(v11, localPolyA.radius, normal01);
                let c201: Vec2 = b2MulAdd(v22, -localPolyB.radius, normal01);
                manifold.normal = normal01;
                manifold.point0.anchorA = b2Lerp(c101, c201, 0.5f32);
                manifold.point0.separation = distance - radius;
                manifold.point0.id = B2_MAKE_ID(i11, i22);
                manifold.pointCount = 1i32;
            } else if (result.fraction1 == 1.0f32 and result.fraction2 == 0.0f32) {
                var normal10: Vec2 = b2Sub(v21, v12);
                let invDistance10: f32 = 1.0f32 / distance;
                normal10.x = normal10.x * invDistance10;
                normal10.y = normal10.y * invDistance10;
                let c110: Vec2 = b2MulAdd(v12, localPolyA.radius, normal10);
                let c210: Vec2 = b2MulAdd(v21, -localPolyB.radius, normal10);
                manifold.normal = normal10;
                manifold.point0.anchorA = b2Lerp(c110, c210, 0.5f32);
                manifold.point0.separation = distance - radius;
                manifold.point0.id = B2_MAKE_ID(i12, i21);
                manifold.pointCount = 1i32;
            } else if (result.fraction1 == 1.0f32 and result.fraction2 == 1.0f32) {
                var normal11: Vec2 = b2Sub(v22, v12);
                let invDistance11: f32 = 1.0f32 / distance;
                normal11.x = normal11.x * invDistance11;
                normal11.y = normal11.y * invDistance11;
                let c111: Vec2 = b2MulAdd(v12, localPolyA.radius, normal11);
                let c211: Vec2 = b2MulAdd(v22, -localPolyB.radius, normal11);
                manifold.normal = normal11;
                manifold.point0.anchorA = b2Lerp(c111, c211, 0.5f32);
                manifold.point0.separation = distance - radius;
                manifold.point0.id = B2_MAKE_ID(i12, i22);
                manifold.pointCount = 1i32;
            }
        }
    } else {
        manifold = b2ClipPolygons(&localPolyA, &localPolyB, edgeA, edgeB, flip);
    }
    if (manifold.pointCount > 0i32) {
        manifold.normal = b2RotateVector(xfA.q, manifold.normal);
        # Named point slots replace C's indexed pointer; only active slots change.
        manifold.point0.anchorA = b2RotateVector(xfA.q, b2Add(manifold.point0.anchorA, origin));
        manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
        manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
        if (manifold.pointCount > 1i32) {
            manifold.point1.anchorA = b2RotateVector(xfA.q, b2Add(manifold.point1.anchorA, origin));
            manifold.point1.anchorB = b2Add(manifold.point1.anchorA, b2Sub(xfA.p, xfB.p));
            manifold.point1.point = b2Add(xfA.p, manifold.point1.anchorA);
        }
    }
    return manifold;
}

fun b2ComputeHull(points: ref Vec2[1],count: i32) -> Hull = { return b2ComputeHullArray[1i64](points,count); }

fun b2ComputeHull(points: ref Vec2[2],count: i32) -> Hull = { return b2ComputeHullArray[2i64](points,count); }

fun b2ComputeHull(points: ref Vec2[3],count: i32) -> Hull = { return b2ComputeHullArray[3i64](points,count); }

fun b2ComputeHull(points: ref Vec2[4],count: i32) -> Hull = { return b2ComputeHullArray[4i64](points,count); }

fun b2ComputeHull(points: ref Vec2[5],count: i32) -> Hull = { return b2ComputeHullArray[5i64](points,count); }

fun b2ComputeHull(points: ref Vec2[6],count: i32) -> Hull = { return b2ComputeHullArray[6i64](points,count); }

fun b2ComputeHull(points: ref Vec2[7],count: i32) -> Hull = { return b2ComputeHullArray[7i64](points,count); }

fun b2ComputeHull(points: ref Vec2[8],count: i32) -> Hull = { return b2ComputeHullArray[8i64](points,count); }

fun b2ComputeHull(points: ref Vec2[9],count: i32) -> Hull = { return b2ComputeHullArray[9i64](points,count); }

# Same accepted hull predicate; the fixed value adapter changes no vertices or counts.
fun b2ValidateHull(h: ref Hull) -> bool = {
    var shape = Polygon();shape.count = h.count;
    var i: i32 = 0i32;while (i<8i32) { shape.vertices[i] = h.points[i];i += 1i32; }
    return validatePolygonHull(&shape);
}
